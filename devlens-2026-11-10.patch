+{
+  "slug": "world-bank-half-of-poorest-households-get-no-safety-net",
+  "date": "2026-11-10T09:30:00",
+  "modified": "2026-11-10T09:30:00",
+  "title": "Half of Bangladesh's poorest households get no safety net: World Bank",
+  "excerpt": "The country spends 3.5% of GDP on subsidies and social protection, but richer families capture much of it while poverty rises.",
+  "categories": [
+    "research",
+    "policy"
+  ],
+  "tags": [
+    "poverty",
+    "poverty-reduction-decent-employment",
+    "social-protection",
+    "power-and-energy",
+    "agriculture",
+    "food-security",
+    "governance",
+    "national",
+    "research"
+  ],
