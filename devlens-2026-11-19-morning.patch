diff --git a/src/data/posts/adb-report-adaptive-social-protection-bangladesh-climate-shocks.json b/src/data/posts/adb-report-adaptive-social-protection-bangladesh-climate-shocks.json
index 65124e3..38c7c2a 100644
--- a/src/data/posts/adb-report-adaptive-social-protection-bangladesh-climate-shocks.json
+++ b/src/data/posts/adb-report-adaptive-social-protection-bangladesh-climate-shocks.json
@@ -17,5 +17,5 @@
   "aid-financing"
  ],
  "image": null,
- "content": "<p class=\"wp-block-paragraph\">Bangladesh's social protection system reaches about three in 10 households and is poorly set up to protect people from climate shocks, according to a report the Asian Development Bank (ADB) published on 18 November, Strengthening Adaptive Social Protection in Bangladesh.</p>\n\n<p class=\"wp-block-paragraph\">The 52-page report found that 46.5% of beneficiaries did not meet the poverty criteria, while 71.0% of eligible families were excluded. Thirty-nine ministries and agencies run 115 safety net programmes, and key programmes provide less than 10.0% of the average income of poor and extremely poor households.</p>\n\n<p class=\"wp-block-paragraph\">Social protection spending averaged 2.54% of GDP from 2015-16 to 2024-25. Without pensions and interest subsidies it was about 1.76% of GDP in 2024-25. About 10% of the 2024-25 social protection budget, over $722 million, went to disaster-related programmes.</p>\n\n<p class=\"wp-block-paragraph\">The country faced 185 climate-related shocks from 2000 to 2019, and 58.3% of the population is exposed to climate hazards. Cyclones and floods could cost about $3.2 billion a year, about 2.2% of GDP. After Cyclone Aila, unemployment rose from 11% to 60% and the poverty headcount from 41% to 63%, the report says.</p>\n\n<p class=\"wp-block-paragraph\">It finds that a Tk 80 billion (about $650 million) contingency fund has been little used, and that the Ministry of Disaster Management and Relief's 2012 humanitarian guidelines do not allow money to be released before a shock. It recommends building adaptive social protection fully into the updated National Social Security Strategy, making anticipatory cash transfers routine, linking information systems with climate risk data, and setting up dedicated financing.</p>\n\n<p class=\"wp-block-paragraph\">The lead authors are Shaila Rahman and Fazle Elahi Mahmud of Quay Asia, with management by Babken Babajanian of ADB. The report draws on a literature review and interviews with 26 people from government, development partners, UN agencies and civil society.</p>\n\n<h3 class=\"wp-block-heading\">Why it matters</h3>\n\n<p class=\"wp-block-paragraph\">NGOs run much of the anticipatory cash and early recovery work in Bangladesh, often with donor money because government rules do not allow payouts before a disaster. The report backs changing those rules and fixing targeting, both of which decide who gets help when the next cyclone hits.</p>\n\n<h3 class=\"wp-block-heading\">What to watch</h3>\n\n<p class=\"wp-block-paragraph\">Whether the updated National Social Security Strategy and the MODMR guidelines are revised to allow forecast-based transfers, and how the new Global Shield grants are linked to the safety net system.</p>\n\n<h3 class=\"wp-block-heading\">Sources</h3>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https://www.adb.org/publications/adaptive-social-protection-bangladesh-report\" target=\"_blank\" rel=\"noopener\">Asian Development Bank: Strengthening Adaptive Social Protection in Bangladesh, 18 November 2026</a></li>\n<li><a href=\"https://www.adb.org/sites/default/files/publication/1175801/adaptive-social-protection-bangladesh-report.pdf\" target=\"_blank\" rel=\"noopener\">Asian Development Bank: full report (PDF)</a></li>\n</ul>"
+ "content": "<p class=\"wp-block-paragraph\">Bangladesh's social protection system reaches about three in 10 households, citing World Bank figures, and is poorly set up to protect people from climate shocks, according to a report the Asian Development Bank (ADB) published on 18 November, Strengthening Adaptive Social Protection in Bangladesh.</p>\n\n<p class=\"wp-block-paragraph\">The 52-page report found that 46.5% of beneficiaries did not meet the poverty criteria, while 71.0% of eligible families were excluded. Thirty-nine ministries and agencies run 115 safety net programmes, and key programmes provide less than 10.0% of the average income of poor and extremely poor households.</p>\n\n<p class=\"wp-block-paragraph\">Social protection spending averaged 2.54% of GDP from 2015-16 to 2024-25. Without pensions and interest subsidies it was about 1.76% of GDP in 2024-25. About 10% of the 2024-25 social protection budget, over $722 million, went to disaster-related programmes.</p>\n\n<p class=\"wp-block-paragraph\">The country faced 185 climate-related shocks from 2000 to 2019, and 58.3% of the population is exposed to climate hazards. Cyclones and floods could cost about $3.2 billion a year, about 2.2% of GDP. After Cyclone Aila in 2009, unemployment in affected south-west communities rose from 11% to 60% and the poverty headcount from 41% to 63%, the report says.</p>\n\n<p class=\"wp-block-paragraph\">It finds that a Tk 80 billion (about $650 million) contingency fund has been little used, and that the Ministry of Disaster Management and Relief's 2012 humanitarian guidelines do not allow money to be released before a shock. It recommends building adaptive social protection fully into the updated National Social Security Strategy, making anticipatory cash transfers routine, linking information systems with climate risk data, and setting up dedicated financing.</p>\n\n<p class=\"wp-block-paragraph\">The lead authors are Shaila Rahman and Fazle Elahi Mahmud of Quay Asia, with management by Babken Babajanian of ADB. The report draws on a literature review and interviews with 26 people from government, development partners, UN agencies and civil society.</p>\n\n<h3 class=\"wp-block-heading\">Why it matters</h3>\n\n<p class=\"wp-block-paragraph\">NGOs run much of the anticipatory cash and early recovery work in Bangladesh, often with donor money because government rules do not allow payouts before a disaster. The report backs changing those rules and fixing targeting, both of which decide who gets help when the next cyclone hits.</p>\n\n<h3 class=\"wp-block-heading\">What to watch</h3>\n\n<p class=\"wp-block-paragraph\">Whether the updated National Social Security Strategy and the MODMR guidelines are revised to allow forecast-based transfers, and how the new Global Shield grants are linked to the safety net system.</p>\n\n<h3 class=\"wp-block-heading\">Sources</h3>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https://www.adb.org/publications/adaptive-social-protection-bangladesh-report\" target=\"_blank\" rel=\"noopener\">Asian Development Bank: Strengthening Adaptive Social Protection in Bangladesh, 18 November 2026</a></li>\n<li><a href=\"https://www.adb.org/sites/default/files/publication/1175801/adaptive-social-protection-bangladesh-report.pdf\" target=\"_blank\" rel=\"noopener\">Asian Development Bank: full report (PDF)</a></li>\n</ul>"
 }
diff --git a/src/data/posts/alrd-angoc-land-food-sovereignty-conference-farmer-input-card.json b/src/data/posts/alrd-angoc-land-food-sovereignty-conference-farmer-input-card.json
