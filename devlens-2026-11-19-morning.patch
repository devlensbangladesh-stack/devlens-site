+++ b/src/data/posts/foreign-aid-disbursement-down-60-percent-default-loans-32-percent.json
@@ -0,0 +1,18 @@
+{
+ "slug": "foreign-aid-disbursement-down-60-percent-default-loans-32-percent",
+ "date": "2026-11-18T23:05:00",
+ "modified": "2026-11-18T23:05:00",
+ "title": "Foreign aid disbursement falls 60%, finance minister tells parliament",
+ "excerpt": "Amir Khosru Mahmud Chowdhury also said defaulted loans reached 32.17% of all bank loans at the end of September.",
+ "categories": [
+  "news",
+  "data"
+ ],
+ "tags": [
+  "aid-financing",
+  "governance",
+  "poverty"
+ ],
+ "image": null,
+ "content": "<p class=\"wp-block-paragraph\">Foreign aid disbursement in the current fiscal year has fallen 60% compared with the same period last year, Finance Minister Amir Khosru Mahmud Chowdhury told parliament on Monday (16 November), UNB reported. He put the fall down mainly to domestic instability and global crises.</p>\n\n<p class=\"wp-block-paragraph\">Defaulted bank loans reached Tk 5,97,154.93 crore at the end of September, or 32.17% of all loans, he said. The ratio was 7.24% in 2021, 17.83% in 2024 and 29.92% in 2025.</p>\n\n<p class=\"wp-block-paragraph\">The National Board of Revenue provisionally collected Tk 92,525 crore in July to September, 68.68% of its Tk 1,34,396 crore target. Total public debt was estimated at Tk 23,37,575 crore on 30 June, and Tk 8,08,778 crore is set aside for debt repayment this fiscal year, the minister said.</p>\n\n<h3 class=\"wp-block-heading\">Why it matters</h3>\n\n<p class=\"wp-block-paragraph\">Much of the money that pays for development projects, and for programmes NGOs deliver with government and donor partners, comes through foreign aid. A sharp fall in disbursement, with weak revenue and high debt repayment, leaves less room for social spending.</p>\n\n<h3 class=\"wp-block-heading\">What to watch</h3>\n\n<p class=\"wp-block-paragraph\">Which projects and sectors are hit by the slower aid flow, and whether the revised budget cuts development spending further.</p>\n\n<h3 class=\"wp-block-heading\">Sources</h3>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https://unb.com.bd/category/Bangladesh/npls-hit-tk-597-lakh-crore-3217pc-of-total-loans-khosru/200488\" target=\"_blank\" rel=\"noopener\">UNB: NPLs hit Tk 5.97 lakh crore, 32.17pc of total loans: Khosru, 16 November 2026</a></li>\n</ul>"
+}
diff --git a/src/data/posts/global-shield-climate-risk-grants-bangladesh-30-million-euros.json b/src/data/posts/global-shield-climate-risk-grants-bangladesh-30-million-euros.json
new file mode 100644
index 0000000..22a1748
--- /dev/null
+++ b/src/data/posts/global-shield-climate-risk-grants-bangladesh-30-million-euros.json
@@ -0,0 +1,20 @@
+{
+ "slug": "global-shield-climate-risk-grants-bangladesh-30-million-euros",
+ "date": "2026-11-18T23:50:00",
+ "modified": "2026-11-18T23:50:00",
+ "title": "Bangladesh to get €30 million or more in Global Shield climate grants",
+ "excerpt": "The money will fund flood and cyclone risk data, climate insurance for farmers and fishers, and aid released on disaster forecasts.",
+ "categories": [
+  "news",
+  "funding"
+ ],
+ "tags": [
+  "climate-disaster-resilience",
+  "climate-change",
+  "disaster-risk-reduction",
+  "aid-financing",
+  "social-protection"
+ ],
+ "image": null,
+ "content": "<p class=\"wp-block-paragraph\">Bangladesh will receive at least €30 million (about Tk 415 crore) in grants from the Global Shield against Climate Risks, Dr Md Saimum Parvez, Special Assistant to the Prime Minister on Environment, Forest and Climate Change, said at the Bangladesh Pavilion at COP31 in Antalya on Wednesday (18 November), The Business Standard reported, citing BSS.</p>\n\n<p class=\"wp-block-paragraph\">\"This is entirely a grant, not a loan,\" he said. The application was made through the Economic Relations Division (ERD).</p>\n\n<p class=\"wp-block-paragraph\">The money will pay for flood and cyclone risk assessment, better data systems, climate insurance for farmers, fishers and small entrepreneurs, and fast assistance released when forecasts show a disaster is coming. A further $20 million (about Tk 250 crore) could follow if the first phase is carried out well.</p>\n\n<p class=\"wp-block-paragraph\">Bangladesh has also been chosen to prepare an investment plan of up to $30 million under the Climate Investment Funds' ARISE programme, the report said. The Global Shield was set up by the G7 and the V20 group of climate-vulnerable countries.</p>\n\n<h3 class=\"wp-block-heading\">Why it matters</h3>\n\n<p class=\"wp-block-paragraph\">Bangladesh has pressed at COP31 for climate finance as grants rather than loans. This is grant money for exactly the work many NGOs already do: early warning, forecast-based cash, and insurance for poor households. How it is channelled will decide whether community organisations get a share.</p>\n\n<h3 class=\"wp-block-heading\">What to watch</h3>\n\n<p class=\"wp-block-paragraph\">Which agencies and partners will deliver the programmes, whether NGOs and local groups have a role in forecast-based payouts, and when the first money arrives.</p>\n\n<h3 class=\"wp-block-heading\">Sources</h3>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https://www.tbsnews.net/bangladesh/bangladesh-receive-tk415cr-global-shield-grants-saimum-parvez-1606216\" target=\"_blank\" rel=\"noopener\">The Business Standard (BSS): Bangladesh to receive Tk415cr Global Shield grants, 18 November 2026</a></li>\n</ul>"
+}
