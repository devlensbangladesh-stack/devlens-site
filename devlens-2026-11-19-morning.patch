+++ b/src/data/posts/special-solar-power-installation-bill-2026-passed-farmland-tender-concerns.json
@@ -0,0 +1,19 @@
+{
+ "slug": "special-solar-power-installation-bill-2026-passed-farmland-tender-concerns",
+ "date": "2026-11-19T06:20:00",
+ "modified": "2026-11-19T06:20:00",
+ "title": "Parliament passes solar bill despite farmland and tender worries",
+ "excerpt": "Opposition MPs said the law could bypass open tenders and put farmland at risk. The government says small projects will use rooftops and courtyards.",
+ "categories": [
+  "news"
+ ],
+ "tags": [
+  "renewable-energy",
+  "power-and-energy",
+  "land",
+  "governance",
+  "agriculture"
+ ],
+ "image": null,
+ "content": "<p class=\"wp-block-paragraph\">Parliament passed the Special Solar Power Installation Bill, 2026 by voice vote on Wednesday (18 November), the last day of the fourth session of the 13th Jatiya Sangsad, bdnews24.com's Bangla edition reported. The law replaces an ordinance issued on 19 October.</p>\n\n<p class=\"wp-block-paragraph\">State Minister for Power, Energy and Mineral Resources Anindya Islam Amit moved the bill on behalf of the minister, Iqbal Hasan Mahmud. About 8,300 applicants have been found eligible after screening, the paper reported.</p>\n\n<h3 class=\"wp-block-heading\">The objections</h3>\n\n<p class=\"wp-block-paragraph\">Jamaat-e-Islami MPs objected to clause 19, which protects officials for work done in good faith. They warned the law could be used to skip open tenders, and asked for safeguards for farmland and for the Bangladesh Energy Regulatory Commission (BERC) to oversee electricity prices. Abdul Gafur, MP for Kushtia-2, raised the tender and farmland concerns. Their amendments were rejected. The government said small projects will use rooftops and courtyards, and large projects will look at fallow land.</p>\n\n<h3 class=\"wp-block-heading\">Why it matters</h3>\n\n<p class=\"wp-block-paragraph\">More solar power helps Bangladesh cut fuel imports and emissions, but how land is chosen and how contracts are awarded will decide who gains. Farmers' groups, land rights NGOs and anti-corruption groups will want to see the rules that follow the law, especially on farmland and open bidding.</p>\n\n<h3 class=\"wp-block-heading\">What to watch</h3>\n\n<p class=\"wp-block-paragraph\">The rules issued under the new law, the selection of approved applicants, and whether BERC is given a role in setting prices.</p>\n\n<h3 class=\"wp-block-heading\">Sources</h3>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https://bangla.bdnews24.com/bangladesh/3w083nm1f8\" target=\"_blank\" rel=\"noopener\">bdnews24.com (Bangla): Special solar power installation bill passed, 18 November 2026</a></li>\n</ul>"
+}
diff --git a/src/data/posts/tobacco-control-law-amendment-awareness-ngo-affairs-bureau-csr-curbs.json b/src/data/posts/tobacco-control-law-amendment-awareness-ngo-affairs-bureau-csr-curbs.json
new file mode 100644
index 0000000..6574a19
--- /dev/null
+++ b/src/data/posts/tobacco-control-law-amendment-awareness-ngo-affairs-bureau-csr-curbs.json
@@ -0,0 +1,18 @@
+{
+ "slug": "tobacco-control-law-amendment-awareness-ngo-affairs-bureau-csr-curbs",
+ "date": "2026-11-19T06:00:00",
+ "modified": "2026-11-19T06:00:00",
+ "title": "NGO Affairs Bureau joins push to explain amended tobacco law",
+ "excerpt": "The amended law widens smoke-free places, limits marketing and curbs tobacco firms' CSR spending, which could affect NGOs that take such money.",
+ "categories": [
+  "news"
+ ],
+ "tags": [
+  "tobacco-control",
+  "health",
+  "health-nutrition",
+  "governance"
+ ],
+ "image": null,
+ "content": "<p class=\"wp-block-paragraph\">Government agencies, including the NGO Affairs Bureau (NGOAB), met on 17 November to plan how to make people aware of the amended tobacco control law, The Business Standard reported. The global health organisation Vital Strategies organised the day-long workshop on a communication strategy for the Smoking and Tobacco Products Usage (Control) Act, 2005, as amended in 2026.</p>\n\n<h3 class=\"wp-block-heading\">What the amendments do</h3>\n\n<ul class=\"wp-block-list\">\n<li>Widen the places where smoking is banned</li>\n<li>Restrict tobacco marketing</li>\n<li>Curb the tobacco industry's use of corporate social responsibility (CSR) activities</li>\n</ul>\n\n<p class=\"wp-block-paragraph\">Speakers said tobacco-related diseases kill 200,000 people a year in Bangladesh. \"These changes won't mean anything if government officials and citizens are unaware of them,\" said Md Shafiqul Islam, a senior consultant at Vital Strategies.</p>\n\n<p class=\"wp-block-paragraph\">Participants included Dr AKM Mamun Uzzaman, Director at the NGO Affairs Bureau; Sheikh Momena Moni, Additional Secretary (World Health wing) at the Health Services Division; Md Akhteruzzaman, Director General of the National Tobacco Control Cell; Md Mostafizur Rahman, Lead Policy Adviser at the Campaign for Tobacco-Free Kids; and Khaleda Begum, Director General of the Department of Films and Publications.</p>\n\n<h3 class=\"wp-block-heading\">Why it matters</h3>\n\n<p class=\"wp-block-paragraph\">The bureau approves foreign-funded NGO projects, so its part in the campaign matters for the sector. The curbs on tobacco companies' CSR could affect NGOs and community groups that have accepted tobacco industry money for health camps, scholarships or tree planting. Health and youth NGOs also have a role in spreading the word about the new rules.</p>\n\n<h3 class=\"wp-block-heading\">What to watch</h3>\n\n<p class=\"wp-block-paragraph\">Rules and guidance under the amended law, any NGOAB instruction to NGOs on tobacco industry funding, and enforcement of the new smoke-free places.</p>\n\n<h3 class=\"wp-block-heading\">Sources</h3>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https://www.tbsnews.net/bangladesh/health/govt-vital-strategies-join-hands-raise-awareness-amended-tobacco-control-law\" target=\"_blank\" rel=\"noopener\">The Business Standard: Govt, Vital Strategies join hands to raise awareness on amended tobacco control law, 18 November 2026</a></li>\n</ul>"
+}
-- 
