@@ -0,0 +1,19 @@
+{
+ "slug": "cyclone-akvan-severe-signal-3-chattogram-coxs-bazar-mongla-payra",
+ "date": "2026-11-18T23:55:00",
+ "modified": "2026-11-18T23:55:00",
+ "title": "Akvan turns severe; four seaports told to hoist signal 3",
+ "excerpt": "Fishing boats in the northern Bay must shelter now. Heavy rain is possible in Khulna, Barishal and Chattogram divisions.",
+ "categories": [
+  "news"
+ ],
+ "tags": [
+  "climate-disaster-resilience",
+  "natural-disaster",
+  "disaster-management",
+  "fisheries",
+  "coxs-bazar"
+ ],
+ "image": null,
+ "content": "<p class=\"wp-block-paragraph\">Cyclone Akvan has strengthened into a severe cyclone over the west-central Bay of Bengal, and the Chattogram, Cox's Bazar, Mongla and Payra seaports have been told to lower distant warning signal 2 and hoist local warning signal 3, the Bangladesh Meteorological Department said on Wednesday (18 November), bdnews24.com's Bangla edition reported.</p>\n\n<p class=\"wp-block-paragraph\">At noon on Wednesday the storm was 1,235 km south-west of Chattogram port, 1,175 km from Cox's Bazar, 1,135 km from Mongla and 1,125 km from Payra. Sustained winds within 64 km of its centre reach 89 km/h, gusting to 117 km/h. It is moving north-north-west and may cross the North Andhra and South Odisha coast of India around noon on Friday.</p>\n\n<p class=\"wp-block-paragraph\">All fishing boats and trawlers in the northern Bay have been told to go to safe shelter immediately and stay there until further notice. Moderate to heavy rain is possible in parts of Khulna, Barishal and Chattogram divisions.</p>\n\n<h3 class=\"wp-block-heading\">Why it matters</h3>\n\n<p class=\"wp-block-paragraph\">Landfall is forecast in India, but rain and rough seas will reach the Bangladesh coast, including the Rohingya camps in Cox's Bazar. Fishing families lose income for every day boats stay ashore, and disaster response NGOs need to keep volunteers and stocks ready.</p>\n\n<h3 class=\"wp-block-heading\">What to watch</h3>\n\n<p class=\"wp-block-paragraph\">The next Met Office bulletin, any change in the storm's track, rainfall in the coastal districts and the camps, and how long fishing stays suspended.</p>\n\n<h3 class=\"wp-block-heading\">Sources</h3>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https://bangla.bdnews24.com/bangladesh/9z2nxrvubg\" target=\"_blank\" rel=\"noopener\">bdnews24.com (Bangla): Akvan now a severe cyclone, signal 3 at seaports, 18 November 2026</a></li>\n</ul>"
+}
diff --git a/src/data/posts/dengue-1674-admissions-508-deaths-november-18.json b/src/data/posts/dengue-1674-admissions-508-deaths-november-18.json
new file mode 100644
index 0000000..c366a3a
--- /dev/null
+++ b/src/data/posts/dengue-1674-admissions-508-deaths-november-18.json
@@ -0,0 +1,18 @@
+{
+ "slug": "dengue-1674-admissions-508-deaths-november-18",
+ "date": "2026-11-18T23:25:00",
+ "modified": "2026-11-18T23:25:00",
+ "title": "Dengue admissions rise to 1,674 in a day; deaths reach 508",
+ "excerpt": "One more person died of dengue in the 24 hours to Wednesday morning, and 5,617 patients are still in hospital, DGHS figures show.",
+ "categories": [
+  "news",
+  "data"
+ ],
+ "tags": [
+  "health",
+  "health-nutrition",
+  "health-support"
+ ],
+ "image": null,
+ "content": "<p class=\"wp-block-paragraph\">Hospitals admitted 1,674 dengue patients in the 24 hours to 8am on Wednesday (18 November), up from 1,537 a day earlier, according to Directorate General of Health Services (DGHS) figures reported by bdnews24.com's Bangla edition. One more death, in Dhaka division, took this year's toll to 508.</p>\n\n<p class=\"wp-block-paragraph\">Dhaka division had the most new admissions (714), followed by Chattogram (311), Barishal (213), Khulna (190), Rajshahi (115), Rangpur (60), Mymensingh (50) and Sylhet (21).</p>\n\n<p class=\"wp-block-paragraph\">So far this year, 167,318 people have been admitted with dengue and 161,193 have been discharged. 5,617 patients were still in hospital.</p>\n\n<p class=\"wp-block-paragraph\">State Minister for Health and Family Welfare Dr M A Muhit said on 17 November that all dengue tests are now free at government hospitals and 2,000 doctors have been trained, The Financial Express reported.</p>\n\n<h3 class=\"wp-block-heading\">Why it matters</h3>\n\n<p class=\"wp-block-paragraph\">Admissions are rising again in mid-November, well past the usual peak, and cases are spread across every division. Health NGOs and community clinics are seeing the load outside Dhaka too.</p>\n\n<h3 class=\"wp-block-heading\">What to watch</h3>\n\n<p class=\"wp-block-paragraph\">Daily admissions over the next two weeks, as experts have warned of a hard December, and whether free testing reaches upazila level.</p>\n\n<h3 class=\"wp-block-heading\">Sources</h3>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https://bangla.bdnews24.com/bangladesh/55x4s6kje5\" target=\"_blank\" rel=\"noopener\">bdnews24.com (Bangla): Dengue: one death, 1,674 in hospital, 18 November 2026</a></li>\n<li><a href=\"https://today.thefinancialexpress.com.bd/metro-news/govt-hospitals-offering-all-dengue-tests-for-free-1794934610\" target=\"_blank\" rel=\"noopener\">The Financial Express: Govt hospitals offering all dengue tests for free, 18 November 2026</a></li>\n</ul>"
+}
diff --git a/src/data/posts/foreign-aid-disbursement-down-60-percent-default-loans-32-percent.json b/src/data/posts/foreign-aid-disbursement-down-60-percent-default-loans-32-percent.json
