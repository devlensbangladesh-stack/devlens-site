diff --git a/src/data/posts/adb-1000-mw-solar-battery-storage-ppp-monitor-country-strategy-2028-2032.json b/src/data/posts/adb-1000-mw-solar-battery-storage-ppp-monitor-country-strategy-2028-2032.json
