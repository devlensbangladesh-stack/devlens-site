index 0000000..4d4fc37
--- /dev/null
+++ b/src/data/posts/cyclone-akvan-heavy-rain-five-divisions-saint-martins-tourists-stranded.json
@@ -0,0 +1,20 @@
+{
+ "slug": "cyclone-akvan-heavy-rain-five-divisions-saint-martins-tourists-stranded",
+ "date": "2026-11-19T16:30:00",
+ "modified": "2026-11-19T16:30:00",
+ "title": "Akvan brings heavy rain warning; 1,500 stranded on Saint Martin's",
+ "excerpt": "Heavy to very heavy rain is forecast for five divisions for 48 hours. The cyclone is expected to make landfall in India on Friday.",
+ "categories": [
+  "news"
+ ],
+ "tags": [
+  "natural-disaster",
+  "climate-disaster-resilience",
+  "disaster-management",
+  "disaster-risk-reduction",
+  "fisheries",
+  "coxs-bazar"
+ ],
+ "image": null,
+ "content": "<p class=\"wp-block-paragraph\">The Bangladesh Meteorological Department has forecast heavy to very heavy rain in Rajshahi, Dhaka, Khulna, Barishal and Chattogram divisions for 48 hours from 10am on Thursday (19 November) as Severe Cyclone Akvan moves through the Bay of Bengal, bdnews24.com reported.</p>\n\n<p class=\"wp-block-paragraph\">About 1,500 tourists are stranded on Saint Martin's Island after ships stopped running on Thursday, the paper said in a separate report.</p>\n\n<h3 class=\"wp-block-heading\">Where the storm is</h3>\n\n<p class=\"wp-block-paragraph\">At 6am the cyclone was 1,125 km south-west of Chattogram port, with winds of up to 89 kph near the centre, gusting to 117 kph. Local warning signal 3 remains in force at the four seaports and fishing boats have been told to stay in shelter. The storm is expected to cross the northern Andhra Pradesh or southern Odisha coast in India by noon on Friday.</p>\n\n<p class=\"wp-block-paragraph\">Additional District Magistrate Tasnim Jahan said ship services to Saint Martin's would stay suspended \"until weather conditions improve\". Hossain Islam Bahadur, general secretary of the Sea Cruise Operators Owners Association, said ticket holders could get refunds or reuse their tickets.</p>\n\n<h3 class=\"wp-block-heading\">Why it matters</h3>\n\n<p class=\"wp-block-paragraph\">Bangladesh is not expected to take a direct hit, but two days of heavy rain in late November can damage Aman rice close to harvest, flood low-lying settlements and keep fishers out of work. Coastal and Rohingya camp programmes may need to check drainage and shelters.</p>\n\n<h3 class=\"wp-block-heading\">What to watch</h3>\n\n<p class=\"wp-block-paragraph\">Rainfall totals and any landslide warnings for Cox's Bazar and the camps, crop damage reports, and when ship services resume.</p>\n\n<h3 class=\"wp-block-heading\">Sources</h3>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https://bdnews24.com/bangladesh/9sdtcvrd6j\" target=\"_blank\" rel=\"noopener\">bdnews24.com: Heavy rain likely in five divisions as Cyclone Akvan moves, 19 November 2026</a></li>\n<li><a href=\"https://bdnews24.com/bangladesh/o2wp71eclh\" target=\"_blank\" rel=\"noopener\">bdnews24.com: 1,500 tourists stranded on Saint Martin's, 19 November 2026</a></li>\n</ul>"
+}
diff --git a/src/data/posts/financial-inclusion-survey-35-percent-excluded-women-agent-banking-half.json b/src/data/posts/financial-inclusion-survey-35-percent-excluded-women-agent-banking-half.json
new file mode 100644
index 0000000..82f0259
--- /dev/null
+++ b/src/data/posts/financial-inclusion-survey-35-percent-excluded-women-agent-banking-half.json
@@ -0,0 +1,21 @@
+{
+ "slug": "financial-inclusion-survey-35-percent-excluded-women-agent-banking-half",
+ "date": "2026-11-19T16:10:00",
+ "modified": "2026-11-19T16:10:00",
+ "title": "Survey: 35% excluded from finance; women hold half of agent accounts",
+ "excerpt": "A national survey finds 55.7% of women have no phone of their own. Bangladesh Bank data show women own about 13.8 million agent banking accounts.",
+ "categories": [
+  "news",
+  "data"
+ ],
+ "tags": [
+  "women-empowerment",
+  "gender-equality",
+  "digital-development",
+  "livelihoods-economic-empowerment",
+  "research",
+  "poverty-reduction-decent-employment"
+ ],
+ "image": null,
+ "content": "<p class=\"wp-block-paragraph\">About 35% of people in Bangladesh are excluded from formal financial services and 64.5% are included, according to the National Financial Inclusion Survey 2025 released in Dhaka on Wednesday (18 November), The Business Standard reported.</p>\n\n<p class=\"wp-block-paragraph\">Separately, Bangladesh Bank's quarterly report shows women now hold about half of all agent banking accounts, The Daily Star reported.</p>\n\n<h3 class=\"wp-block-heading\">The survey</h3>\n\n<p class=\"wp-block-paragraph\">More than half of women (55.7%) do not own a personal mobile phone. Only 8% of bank account holders use a debit card and only 21% of mobile financial service users use an app. About 34% of MFS users transact on basic phones costing Tk 1,000 to 1,200, and fewer than 4% pay bills through MFS.</p>\n\n<p class=\"wp-block-paragraph\">About 70% of women and 59% of men do not know about spreading their investments to protect savings from inflation. Women receive remittances into bank accounts more often than men, 26.1% against 11.5%. M Abdur Razzaque of the research group RAPID gave the keynote at the launch.</p>\n\n<h3 class=\"wp-block-heading\">Agent banking</h3>\n\n<p class=\"wp-block-paragraph\">At the end of September there were 27.8 million agent banking accounts, about 13.8 million of them held by women, and 85% in rural areas. Thirty banks run more than 20,600 outlets. Deposits rose 2.31% in the quarter to Tk 53,108 crore. The 2,244 women-owned outlets hold about 2.5 million accounts and Tk 4,822 crore in deposits.</p>\n\n<h3 class=\"wp-block-heading\">Why it matters</h3>\n\n<p class=\"wp-block-paragraph\">For NGOs running savings groups, cash transfers or women's economic empowerment programmes, the phone gap matters most: digital payments do not reach women who have no phone. Agent banking is now a real rural channel that programmes can use.</p>\n\n<h3 class=\"wp-block-heading\">What to watch</h3>\n\n<p class=\"wp-block-paragraph\">Whether Bangladesh Bank sets targets on women's phone and account access in its next financial inclusion strategy.</p>\n\n<h3 class=\"wp-block-heading\">Sources</h3>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https://www.tbsnews.net/economy/70-women-unaware-investment-diversification-survey-1607251\" target=\"_blank\" rel=\"noopener\">The Business Standard: 70% women unaware of investment diversification: survey, 19 November 2026</a></li>\n<li><a href=\"https://www.thedailystar.net/business/news/women-hold-half-agent-banking-accounts-bb-4326541\" target=\"_blank\" rel=\"noopener\">The Daily Star: Women hold half of agent banking accounts: BB, 18 November 2026</a></li>\n</ul>"
+}
