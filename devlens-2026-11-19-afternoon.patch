--- /dev/null
+++ b/src/data/posts/sylhet-measles-223-deaths-three-infants-die-osmani-hospital.json
@@ -0,0 +1,18 @@
+{
+ "slug": "sylhet-measles-223-deaths-three-infants-die-osmani-hospital",
+ "date": "2026-11-19T16:33:00",
+ "modified": "2026-11-19T16:33:00",
+ "title": "Measles deaths in Sylhet division reach 223 as three infants die",
+ "excerpt": "The babies, aged seven and eight months, were too young for routine measles vaccination. Sylhet has 555 measles patients in hospital.",
+ "categories": [
+  "news"
+ ],
+ "tags": [
+  "health",
+  "health-nutrition",
+  "child-protection",
+  "health-support"
+ ],
+ "image": null,
+ "content": "<p class=\"wp-block-paragraph\">Three babies aged seven to eight months, from Habiganj, Sunamganj and Sylhet, died at MAG Osmani Medical College Hospital between Wednesday and Thursday morning (19 November), taking measles and measles-like deaths in Sylhet division to 223, bdnews24.com's Bangla edition reported. Ten of the deaths were confirmed by laboratory tests.</p>\n\n<p class=\"wp-block-paragraph\">There are 555 measles patients in hospital in the division, 141 of them admitted in the last 24 hours, said Mohammad Nur-e-Alam Shamim, assistant director of the Sylhet divisional health office. The division has had 1,806 laboratory-confirmed cases since 1 January.</p>\n\n<h3 class=\"wp-block-heading\">Why it matters</h3>\n\n<p class=\"wp-block-paragraph\">Sylhet has had 9.1 deaths per 1,000 cases against a national average of 4.8, The Daily Star reported this week. Babies under nine months are too young for the routine first measles dose, so they depend on the immunity of the people around them. Health and nutrition NGOs in the haor districts can help find unvaccinated children and get sick infants to care early.</p>\n\n<h3 class=\"wp-block-heading\">What to watch</h3>\n\n<p class=\"wp-block-paragraph\">Whether the catch-up campaign reaches more children in Sunamganj and Habiganj, and whether health authorities consider an early extra dose for infants in outbreak areas.</p>\n\n<h3 class=\"wp-block-heading\">Sources</h3>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https://bangla.bdnews24.com/samagrabangladesh/3bwoasw47c\" target=\"_blank\" rel=\"noopener\">bdnews24.com (Bangla): Three more children die of measles in Sylhet, 19 November 2026</a></li>\n<li><a href=\"https://campaign.thedailystar.net/health-promises-and-measles/\" target=\"_blank\" rel=\"noopener\">The Daily Star: Health promises and measles, 18 November 2026</a></li>\n</ul>"
+}
