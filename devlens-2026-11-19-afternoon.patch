index 0000000..65d1be9
--- /dev/null
+++ b/src/data/posts/garment-workers-council-demands-tk-32000-wage-buyers-hold-orders-factories-shut.json
@@ -0,0 +1,19 @@
+{
+ "slug": "garment-workers-council-demands-tk-32000-wage-buyers-hold-orders-factories-shut",
+ "date": "2026-11-19T16:25:00",
+ "modified": "2026-11-19T16:25:00",
+ "title": "Workers' council seeks Tk 32,000 wage as buyers hold back orders",
+ "excerpt": "The union group wants 12 arrested leaders freed. About 50 Gazipur factories and 28 in Savar and Ashulia are shut, and buyers want a quick end to unrest.",
+ "categories": [
+  "news"
+ ],
+ "tags": [
+  "garments",
+  "poverty-reduction-decent-employment",
+  "human-rights",
+  "governance-human-rights",
+  "livelihoods-economic-empowerment"
+ ],
+ "image": null,
+ "content": "<p class=\"wp-block-paragraph\">The IndustriALL Bangladesh Council demanded a minimum wage of Tk 32,000 for garment workers at a press conference at the National Press Club on Thursday (19 November), The Business Standard reported. It also called for the release of 12 leaders and activists of its affiliated federations arrested since late October.</p>\n\n<p class=\"wp-block-paragraph\">The current minimum wage is Tk 12,500. A wage board was formed on 1 November and factory owners are due to give their proposal on 23 November, The Daily Star reported.</p>\n\n<h3 class=\"wp-block-heading\">Closures and buyers</h3>\n\n<p class=\"wp-block-paragraph\">Twenty-eight factories in Savar and Ashulia were closed under section 13(1) of the Labour Act, said Mominul Islam Bhuiyan, superintendent of Industrial Police-1, and about 50 factories in Gazipur were shut indefinitely, said Md Amjad Hossain, superintendent of Gazipur Industrial Police, The Business Standard reported.</p>\n\n<p class=\"wp-block-paragraph\">Buyers including H&M and Inditex met the BGMEA on 18 November and asked for a quick end to the unrest, The Daily Star reported, citing a BGMEA director. Many buyers are holding back autumn and winter orders.</p>\n\n<p class=\"wp-block-paragraph\">Council general secretary Salauddin Swapn presented the demand. Senior vice-president Amirul Haque Amin called the wage proposal of the Centre for Policy Dialogue inadequate. The council also urged workers to go back to work while the wage board decides.</p>\n\n<h3 class=\"wp-block-heading\">Why it matters</h3>\n\n<p class=\"wp-block-paragraph\">Arrests of union leaders and closures under section 13(1), which lets owners shut factories without paying wages, raise labour rights and civic space concerns. Lost wages hit workers' families quickly, and NGOs working in industrial areas on health, children and microfinance will feel it.</p>\n\n<h3 class=\"wp-block-heading\">What to watch</h3>\n\n<p class=\"wp-block-paragraph\">The owners' proposal on 23 November, any release of the arrested leaders, and whether factories reopen.</p>\n\n<h3 class=\"wp-block-heading\">Sources</h3>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https://www.tbsnews.net/bangladesh/industrial-council-demands-tk32000-minimum-wage-rmg-workers-1607701\" target=\"_blank\" rel=\"noopener\">The Business Standard: Industrial council demands Tk32,000 minimum wage for RMG workers, 19 November 2026</a></li>\n<li><a href=\"https://www.tbsnews.net/bangladesh/workers-continue-work-stoppage-savar-ashulia-50-gazipur-factories-shut-1607406\" target=\"_blank\" rel=\"noopener\">The Business Standard: Workers continue work stoppage in Savar, Ashulia; 50 Gazipur factories shut, 19 November 2026</a></li>\n<li><a href=\"https://www.thedailystar.net/business/news/international-rmg-buyers-seek-quick-resolution-labour-crisis-4327881\" target=\"_blank\" rel=\"noopener\">The Daily Star: International RMG buyers seek quick resolution of labour crisis, 19 November 2026</a></li>\n</ul>"
+}
diff --git a/src/data/posts/grameen-bank-office-muksudpur-gopalganj-set-on-fire.json b/src/data/posts/grameen-bank-office-muksudpur-gopalganj-set-on-fire.json
new file mode 100644
index 0000000..a694d34
--- /dev/null
+++ b/src/data/posts/grameen-bank-office-muksudpur-gopalganj-set-on-fire.json
@@ -0,0 +1,19 @@
+{
+ "slug": "grameen-bank-office-muksudpur-gopalganj-set-on-fire",
+ "date": "2026-11-19T16:28:00",
+ "modified": "2026-11-19T16:28:00",
+ "title": "Another Grameen Bank office set on fire, in Muksudpur, Gopalganj",
+ "excerpt": "Marchers burned the office beside Muksudpur police station, which was also set on fire, adding to a wave of arson against the microfinance bank.",
+ "categories": [
+  "news"
+ ],
+ "tags": [
+  "man-made-disaster",
+  "public-order-and-safety",
+  "poverty-reduction-decent-employment",
+  "livelihoods-economic-empowerment",
+  "governance-human-rights"
+ ],
+ "image": null,
+ "content": "<p class=\"wp-block-paragraph\">Marchers vandalised and set fire to a Grameen Bank office in Farid Mia Super Market in Muksudpur, Gopalganj, on Thursday (19 November), bdnews24.com's Bangla edition reported. The market stands beside Muksudpur police station, which was vandalised and set on fire at around 11:30am the same day. No one was reported hurt at the police station, which had been empty since Wednesday evening.</p>\n\n<p class=\"wp-block-paragraph\">Local people said hundreds of activists of the banned Awami League and its affiliated groups marched in the area, the paper reported. The house of Selimuzzaman Selim, the BNP MP for Gopalganj-1, in Kashiani was vandalised and set on fire, and the Dhaka-Khulna and Dhaka-Barishal highways were blocked with felled trees. The report gave no figures for damage at the bank office.</p>\n\n<h3 class=\"wp-block-heading\">Why it matters</h3>\n\n<p class=\"wp-block-paragraph\">Grameen Bank said last week that 22 of its branches in 16 districts had been set on fire or targeted between 10 and 17 November, and the UN has called for all the violence to be investigated (<a href=\"/2026/11/17/grameen-bank-22-branches-arson-attacks-un-calls-for-investigation/\">see our earlier report</a>). Branch offices hold borrowers' records and savings, and staff and members, most of them poor women, bear the risk. Other microfinance NGOs in the same areas may need to review security.</p>\n\n<h3 class=\"wp-block-heading\">What to watch</h3>\n\n<p class=\"wp-block-paragraph\">Arrests and statements from Grameen Bank and the police, and whether the attacks spread to other microfinance providers.</p>\n\n<h3 class=\"wp-block-heading\">Sources</h3>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https://bangla.bdnews24.com/samagrabangladesh/bberr4faon\" target=\"_blank\" rel=\"noopener\">bdnews24.com (Bangla): Police station attacked, Grameen Bank office set on fire in Muksudpur, 19 November 2026</a></li>\n</ul>"
+}
diff --git a/src/data/posts/haor-farmers-brri-dhan-118-early-rice-beat-flash-floods.json b/src/data/posts/haor-farmers-brri-dhan-118-early-rice-beat-flash-floods.json
new file mode 100644
index 0000000..821bebd
--- /dev/null
+++ b/src/data/posts/haor-farmers-brri-dhan-118-early-rice-beat-flash-floods.json
@@ -0,0 +1,19 @@
+{
+ "slug": "haor-farmers-brri-dhan-118-early-rice-beat-flash-floods",
+ "date": "2026-11-19T16:05:00",
+ "modified": "2026-11-19T16:05:00",
+ "title": "Haor farmers get early rice variety to beat flash floods",
+ "excerpt": "BRRI dhan118 can be harvested 7 to 10 days earlier. Floods last year damaged crops worth about Tk 1,047 crore in the haor.",
+ "categories": [
+  "news"
+ ],
+ "tags": [
+  "agriculture",
+  "food-security-agriculture",
+  "climate-change",
+  "climate-disaster-resilience",
+  "natural-disaster"
+ ],
+ "image": null,
+ "content": "<p class=\"wp-block-paragraph\">Farmers in seven haor districts are getting an early-maturing rice variety, BRRI dhan118, to help them harvest before flash floods arrive, The Daily Star reported on Thursday (19 November). About 1,600 demonstration plots have been set up and 30 tonnes of seed distributed.</p>\n\n<p class=\"wp-block-paragraph\">The variety can be harvested 7 to 10 days earlier than the varieties now grown. Flash floods between 26 April and 4 May last year damaged crops worth about Tk 1,047 crore on more than 49,000 hectares, the paper said.</p>\n\n<h3 class=\"wp-block-heading\">Who is involved</h3>\n\n<p class=\"wp-block-paragraph\">The Daily Star quoted Md Rafiqul Islam, director general of the Bangladesh Rice Research Institute (BRRI), and Mohammad Zakir Hossain, senior information officer at the agriculture ministry.</p>\n\n<h3 class=\"wp-block-heading\">Why it matters</h3>\n\n<p class=\"wp-block-paragraph\">In the haor, a few days can decide whether a family keeps its only rice crop of the year. Food security and climate adaptation NGOs in Sunamganj, Netrokona, Kishoreganj and nearby districts can link seed, early warning and harvest support.</p>\n\n<h3 class=\"wp-block-heading\">What to watch</h3>\n\n<p class=\"wp-block-paragraph\">Yields from the demonstration plots in April and May, and whether seed supply is scaled up for the next Boro season.</p>\n\n<h3 class=\"wp-block-heading\">Sources</h3>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https://www.thedailystar.net/business/economy/news/haor-farmers-get-early-maturing-rice-beat-flash-flood-4327581\" target=\"_blank\" rel=\"noopener\">The Daily Star: Haor farmers get early-maturing rice to beat flash flood, 19 November 2026</a></li>\n</ul>"
+}
diff --git a/src/data/posts/ipc-18-1-million-acute-food-insecurity-prices-squeeze-families.json b/src/data/posts/ipc-18-1-million-acute-food-insecurity-prices-squeeze-families.json
new file mode 100644
index 0000000..11ae09b
--- /dev/null
+++ b/src/data/posts/ipc-18-1-million-acute-food-insecurity-prices-squeeze-families.json
@@ -0,0 +1,20 @@
+{
+ "slug": "ipc-18-1-million-acute-food-insecurity-prices-squeeze-families",
+ "date": "2026-11-19T16:40:00",
+ "modified": "2026-11-19T16:40:00",
+ "title": "18.1 million people face acute food insecurity as prices climb",
+ "excerpt": "The IPC projection for September to December is up from 15.3 million in the lean season. Bread, milk and hundreds of medicines now cost more.",
+ "categories": [
+  "news"
+ ],
+ "tags": [
+  "food-security",
+  "food-security-agriculture",
+  "poverty",
+  "poverty-reduction-decent-employment",
+  "social-protection",
+  "nutrition"
+ ],
+ "image": null,
+ "content": "<p class=\"wp-block-paragraph\">About 18.1 million people in Bangladesh are projected to face acute food insecurity between September and December 2026, including about 787,000 at emergency level, according to the Integrated Food Security Phase Classification (IPC) figures cited by The Business Standard on Thursday (19 November).</p>\n\n<p class=\"wp-block-paragraph\">From May to August, 15.3 million people, 15% of the population analysed, faced acute food insecurity, the IPC found.</p>\n\n<h3 class=\"wp-block-heading\">Prices and poverty</h3>\n\n<p class=\"wp-block-paragraph\">Bakery prices are up 20%, said Jalal Uddin, president of the bread and biscuit manufacturers' association. Milk has risen from Tk 100 to Tk 110 to 115 a litre, and hundreds of medicine prices have gone up 5% to 10% in three months, said Zakir Hossain, secretary of the Bangladesh Association of Pharmaceutical Industries.</p>\n\n<p class=\"wp-block-paragraph\">The Policy Research Institute's State of the Real Economy 2026 report put poverty at 27.9% in 2025, with another 18% vulnerable to falling into it. Zahid Hussain, former lead economist at the World Bank's Dhaka office, said incomes had not kept up with costs.</p>\n\n<h3 class=\"wp-block-heading\">Why it matters</h3>\n\n<p class=\"wp-block-paragraph\">The rise from 15.3 million to 18.1 million people comes as food rations for Rohingya refugees have been cut and safety nets miss many poor families. Food assistance, nutrition and cash programmes may face more demand going into winter.</p>\n\n<h3 class=\"wp-block-heading\">What to watch</h3>\n\n<p class=\"wp-block-paragraph\">Government open market sales and food-friendly programme coverage, the next IPC update, and medicine price controls.</p>\n\n<h3 class=\"wp-block-heading\">Sources</h3>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https://www.tbsnews.net/bangladesh/food-medicine-rising-costs-squeeze-families-1607341\" target=\"_blank\" rel=\"noopener\">The Business Standard: Food, medicine: rising costs squeeze families, 19 November 2026</a></li>\n</ul>"
+}
diff --git a/src/data/posts/measles-deaths-1336-health-scorecard-leaves-out-measles.json b/src/data/posts/measles-deaths-1336-health-scorecard-leaves-out-measles.json
new file mode 100644
index 0000000..9d177c8
--- /dev/null
+++ b/src/data/posts/measles-deaths-1336-health-scorecard-leaves-out-measles.json
@@ -0,0 +1,19 @@
+{
+ "slug": "measles-deaths-1336-health-scorecard-leaves-out-measles",
+ "date": "2026-11-19T16:35:00",
+ "modified": "2026-11-19T16:35:00",
+ "title": "Measles deaths reach 1,336; health scorecard leaves out measles",
+ "excerpt": "Seven more children died in a day. A Daily Star investigation finds the outbreak missing from the health ministry's 180-day scorecard.",
+ "categories": [
+  "news"
+ ],
+ "tags": [
+  "health",
+  "health-nutrition",
+  "child-protection",
+  "nutrition",
+  "health-support"
+ ],
+ "image": null,
+ "content": "<p class=\"wp-block-paragraph\">Seven more children died of measles or measles-like symptoms in the 24 hours to Thursday morning (19 November), taking the death toll to 1,336, The Business Standard reported, citing the Directorate General of Health Services (DGHS). Of the deaths, 1,231 were suspected and 105 confirmed.</p>\n\n<p class=\"wp-block-paragraph\">Suspected cases have reached 253,408, with 1,235 new in a day, and confirmed cases 25,881. Since 15 March, 226,469 people have been admitted to hospital and 217,540 have recovered.</p>\n\n<h3 class=\"wp-block-heading\">Missing from the scorecard</h3>\n\n<p class=\"wp-block-paragraph\">A Daily Star investigation published on 18 November found that the government's 180-day scorecard of 12 health commitments ends with the entry \"Measles: not mentioned.\" Deaths rose from 27 on 4 April to 1,318 by 16 November, the paper said, and the catch-up vaccination campaign began 41 days after the 180-day mark, by which time 179 children had died.</p>\n\n<p class=\"wp-block-paragraph\">The paper cited a Red Crescent and IFRC survey of 2,746 households that found 88.9% had borrowed money for treatment, and a Shishu Hospital and icddr,b study that found 65% of hospitalised children under five were malnourished. Health Minister Sardar Md Sakhawat Husain called the criticism \"criticism for the sake of criticism\".</p>\n\n<h3 class=\"wp-block-heading\">Why it matters</h3>\n\n<p class=\"wp-block-paragraph\">The outbreak is now one of the deadliest in the country's recent history. Borrowing for treatment and high malnutrition among sick children point to where health, nutrition and cash support NGOs can help most.</p>\n\n<h3 class=\"wp-block-heading\">What to watch</h3>\n\n<p class=\"wp-block-paragraph\">Daily DGHS figures, the reach of the catch-up campaign in Sylhet and other high-death areas, and whether the ministry publishes a measles plan.</p>\n\n<h3 class=\"wp-block-heading\">Sources</h3>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https://www.tbsnews.net/bangladesh/health/measles-death-toll-reaches-1336-7-more-children-die-1607756\" target=\"_blank\" rel=\"noopener\">The Business Standard: Measles death toll reaches 1,336 as 7 more children die, 19 November 2026</a></li>\n<li><a href=\"https://campaign.thedailystar.net/health-promises-and-measles/\" target=\"_blank\" rel=\"noopener\">The Daily Star: Health promises and measles, 18 November 2026</a></li>\n</ul>"
+}
diff --git a/src/data/posts/pm-10000-workers-malaysia-cost-cap-recruitment-syndicates-parliament.json b/src/data/posts/pm-10000-workers-malaysia-cost-cap-recruitment-syndicates-parliament.json
new file mode 100644
index 0000000..8eb4c46
--- /dev/null
+++ b/src/data/posts/pm-10000-workers-malaysia-cost-cap-recruitment-syndicates-parliament.json
@@ -0,0 +1,18 @@
+{
+ "slug": "pm-10000-workers-malaysia-cost-cap-recruitment-syndicates-parliament",
+ "date": "2026-11-19T16:20:00",
+ "modified": "2026-11-19T16:20:00",
+ "title": "10,000 workers to go to Malaysia at low cost, PM tells parliament",
+ "excerpt": "Tarique Rahman said 1,000 places are set aside for families of victims of enforced disappearance and the July uprising, and syndicates will face action.",
+ "categories": [
+  "news"
+ ],
+ "tags": [
+  "migration",
+  "migrant-protection-and-support",
+  "anti-trafficking-and-exploitation-prevention",
+  "poverty-reduction-decent-employment"
+ ],
+ "image": null,
+ "content": "<p class=\"wp-block-paragraph\">Ten thousand Bangladeshi workers will go to Malaysia at almost no cost, Prime Minister Tarique Rahman told parliament on Wednesday (18 November), The Financial Express reported. About 1,000 of the places are set aside for families of victims of enforced disappearance and of the 2024 uprising.</p>\n\n<p class=\"wp-block-paragraph\">bdnews24.com reported that the total cost would be capped at Tk 200,000 per worker. The prime minister said the government was identifying the \"syndicates that cheated people\" and that recruitment syndicates had nearly led some countries to stop hiring Bangladeshis.</p>\n\n<h3 class=\"wp-block-heading\">Zero-cost hiring</h3>\n\n<p class=\"wp-block-paragraph\">He was answering a question from Kamrul Hasan, MP for Mymensingh-6. He said talks were also under way with Middle Eastern countries. Separately, Malaysian glove maker Top Glove said in a press release that it was promoting \"100 per cent zero-cost recruitment\" for Bangladeshi workers, The Financial Express reported.</p>\n\n<h3 class=\"wp-block-heading\">Why it matters</h3>\n\n<p class=\"wp-block-paragraph\">High recruitment fees push migrant workers into debt and raise the risk of forced labour and trafficking. Migrant rights NGOs will want to see how the cost cap is enforced and whether workers get written contracts before they leave.</p>\n\n<h3 class=\"wp-block-heading\">What to watch</h3>\n\n<p class=\"wp-block-paragraph\">How the 10,000 workers are selected, whether the cap covers all fees, and any action against recruiting agencies.</p>\n\n<h3 class=\"wp-block-heading\">Sources</h3>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https://thefinancialexpress.com.bd/national/pm-pledges-stern-action-against-manpower-syndicates\" target=\"_blank\" rel=\"noopener\">The Financial Express: PM pledges stern action against manpower syndicates, 18 November 2026</a></li>\n<li><a href=\"https://bdnews24.com/bangladesh/lpdflmj94y\" target=\"_blank\" rel=\"noopener\">bdnews24.com: 10,000 workers to Malaysia, 18 November 2026</a></li>\n<li><a href=\"https://thefinancialexpress.com.bd/trade/top-glove-promotes-zero-cost-recruitment-for-bangladeshi-workers\" target=\"_blank\" rel=\"noopener\">The Financial Express: Top Glove promotes zero-cost recruitment for Bangladeshi workers, 18 November 2026</a></li>\n</ul>"
+}
diff --git a/src/data/posts/pm-3500-hospital-beds-added-40-lakh-patients-on-floors-rangabali.json b/src/data/posts/pm-3500-hospital-beds-added-40-lakh-patients-on-floors-rangabali.json
new file mode 100644
index 0000000..675cff3
--- /dev/null
+++ b/src/data/posts/pm-3500-hospital-beds-added-40-lakh-patients-on-floors-rangabali.json
@@ -0,0 +1,17 @@
+{
+ "slug": "pm-3500-hospital-beds-added-40-lakh-patients-on-floors-rangabali",
+ "date": "2026-11-19T16:15:00",
+ "modified": "2026-11-19T16:15:00",
+ "title": "3,500 hospital beds added, but 40 lakh patients treated on floors",
+ "excerpt": "The prime minister told parliament of the bed shortage and promised to push for a government hospital in Rangabali, home to about 400,000 people.",
+ "categories": [
+  "news"
+ ],
+ "tags": [
+  "health",
+  "health-nutrition",
+  "health-support"
+ ],
+ "image": null,
+ "content": "<p class=\"wp-block-paragraph\">About 3,500 hospital beds have been added across the country in recent months, Prime Minister Tarique Rahman told parliament on Wednesday (18 November), The Financial Express reported, citing BSS. He said about 40 lakh (4 million) patients had been treated on floors and verandas because of the shortage of beds.</p>\n\n<p class=\"wp-block-paragraph\">He promised to push for a government hospital in Rangabali in Patuakhali, which has about 400,000 people and none at present. The question was raised by ABM Mosharraf Hossain, MP for Patuakhali-4. Syed Zainul Abedin, MP for Dhaka-4, also asked about hospital capacity.</p>\n\n<h3 class=\"wp-block-heading\">Why it matters</h3>\n\n<p class=\"wp-block-paragraph\">Hospitals are under strain from the measles and dengue outbreaks, and nearly half of doctor posts at upazila health complexes are empty. Remote coastal areas like Rangabali rely heavily on NGO clinics and referral support.</p>\n\n<h3 class=\"wp-block-heading\">What to watch</h3>\n\n<p class=\"wp-block-paragraph\">Where the new beds are and whether staff are hired to run them, and any budget for a Rangabali hospital.</p>\n\n<h3 class=\"wp-block-heading\">Sources</h3>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https://thefinancialexpress.com.bd/national/3500-hospital-beds-added-in-last-few-months-pm\" target=\"_blank\" rel=\"noopener\">The Financial Express (BSS): 3,500 hospital beds added in last few months: PM, 18 November 2026</a></li>\n</ul>"
+}
diff --git a/src/data/posts/sylhet-measles-223-deaths-three-infants-die-osmani-hospital.json b/src/data/posts/sylhet-measles-223-deaths-three-infants-die-osmani-hospital.json
