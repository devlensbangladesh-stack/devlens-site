@@ -17,5 +17,5 @@
   "poverty-reduction-decent-employment"
  ],
  "image": null,
- "content": "<p class=\"wp-block-paragraph\">About 35% of people in Bangladesh are excluded from formal financial services and 64.5% are included, according to the National Financial Inclusion Survey 2025 released in Dhaka on Wednesday (18 November), The Business Standard reported.</p>\n\n<p class=\"wp-block-paragraph\">Separately, Bangladesh Bank's quarterly report shows women now hold about half of all agent banking accounts, The Daily Star reported.</p>\n\n<h3 class=\"wp-block-heading\">The survey</h3>\n\n<p class=\"wp-block-paragraph\">More than half of women (55.7%) do not own a personal mobile phone. Only 8% of bank account holders use a debit card and only 21% of mobile financial service users use an app. About 34% of MFS users transact on basic phones costing Tk 1,000 to 1,200, and fewer than 4% pay bills through MFS.</p>\n\n<p class=\"wp-block-paragraph\">About 70% of women and 59% of men do not know about spreading their investments to protect savings from inflation. Women receive remittances into bank accounts more often than men, 26.1% against 11.5%. M Abdur Razzaque of the research group RAPID gave the keynote at the launch.</p>\n\n<h3 class=\"wp-block-heading\">Agent banking</h3>\n\n<p class=\"wp-block-paragraph\">At the end of September there were 27.8 million agent banking accounts, about 13.8 million of them held by women, and 85% in rural areas. Thirty banks run more than 20,600 outlets. Deposits rose 2.31% in the quarter to Tk 53,108 crore. The 2,244 women-owned outlets hold about 2.5 million accounts and Tk 4,822 crore in deposits.</p>\n\n<h3 class=\"wp-block-heading\">Why it matters</h3>\n\n<p class=\"wp-block-paragraph\">For NGOs running savings groups, cash transfers or women's economic empowerment programmes, the phone gap matters most: digital payments do not reach women who have no phone. Agent banking is now a real rural channel that programmes can use.</p>\n\n<h3 class=\"wp-block-heading\">What to watch</h3>\n\n<p class=\"wp-block-paragraph\">Whether Bangladesh Bank sets targets on women's phone and account access in its next financial inclusion strategy.</p>\n\n<h3 class=\"wp-block-heading\">Sources</h3>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https://www.tbsnews.net/economy/70-women-unaware-investment-diversification-survey-1607251\" target=\"_blank\" rel=\"noopener\">The Business Standard: 70% women unaware of investment diversification: survey, 19 November 2026</a></li>\n<li><a href=\"https://www.thedailystar.net/business/news/women-hold-half-agent-banking-accounts-bb-4326541\" target=\"_blank\" rel=\"noopener\">The Daily Star: Women hold half of agent banking accounts: BB, 18 November 2026</a></li>\n</ul>"
+ "content": "<p class=\"wp-block-paragraph\">About 35% of people in Bangladesh are excluded from formal financial services and 64.5% are included, according to the National Financial Inclusion Survey 2025 released in Dhaka on Wednesday (18 November), The Business Standard reported.</p>\n\n<p class=\"wp-block-paragraph\">Separately, Bangladesh Bank's quarterly report shows women now hold about half of all agent banking accounts, The Daily Star reported.</p>\n\n<h3 class=\"wp-block-heading\">The survey</h3>\n\n<p class=\"wp-block-paragraph\">More than half of women (55.7%) do not own a personal mobile phone. Only 8% of bank account holders use a debit card and only 21% of mobile financial service users use an app. About 34% of MFS users transact on basic phones costing Tk 1,000 to 1,200, and fewer than 4% use MFS for bill payments and other financial services.</p>\n\n<p class=\"wp-block-paragraph\">About 70% of women and 59% of men do not know about spreading their investments to protect savings from inflation. Women receive remittances into bank accounts more often than men, 26.1% against 11.5%. M Abdur Razzaque of the research group RAPID gave the keynote at the launch.</p>\n\n<h3 class=\"wp-block-heading\">Agent banking</h3>\n\n<p class=\"wp-block-paragraph\">At the end of September there were 27.8 million agent banking accounts, about 13.8 million of them held by women, and 85% in rural areas. Thirty banks run more than 20,600 outlets. Deposits rose 2.31% in the quarter to Tk 53,108 crore. The 2,244 women-owned outlets hold about 2.5 million accounts and Tk 4,822 crore in deposits.</p>\n\n<h3 class=\"wp-block-heading\">Why it matters</h3>\n\n<p class=\"wp-block-paragraph\">For NGOs running savings groups, cash transfers or women's economic empowerment programmes, the phone gap matters most: digital payments do not reach women who have no phone. Agent banking is now a real rural channel that programmes can use.</p>\n\n<h3 class=\"wp-block-heading\">What to watch</h3>\n\n<p class=\"wp-block-paragraph\">Whether Bangladesh Bank sets targets on women's phone and account access in its next financial inclusion strategy.</p>\n\n<h3 class=\"wp-block-heading\">Sources</h3>\n\n<ul class=\"wp-block-list\">\n<li><a href=\"https://www.tbsnews.net/economy/70-women-unaware-investment-diversification-survey-1607251\" target=\"_blank\" rel=\"noopener\">The Business Standard: 70% women unaware of investment diversification: survey, 19 November 2026</a></li>\n<li><a href=\"https://www.thedailystar.net/business/news/women-hold-half-agent-banking-accounts-bb-4326541\" target=\"_blank\" rel=\"noopener\">The Daily Star: Women hold half of agent banking accounts: BB, 18 November 2026</a></li>\n</ul>"
 }
diff --git a/src/data/posts/garment-workers-council-demands-tk-32000-wage-buyers-hold-orders-factories-shut.json b/src/data/posts/garment-workers-council-demands-tk-32000-wage-buyers-hold-orders-factories-shut.json
