---
import Base from '../../layouts/Base.astro';
---
<Base title="Thank you" description="Thank you for taking the Devlens workforce survey.">
  <header class="page-head"><div class="wrap" style="max-width:820px">
    <p class="eyebrow" style="color:#0b8f68">Devlens workforce survey</p>
    <h1>Thank you</h1>
    <p style="font-size:20px;color:#3b4450">Your answers have been sent to the Devlens team. Please share the survey with colleagues who worked in the sector, including those who have left it.</p>
  </div></header>
  <div class="wrap page-body" style="max-width:820px">
    <p><a class="btn btn-dark" style="padding:14px 26px;font-size:16px" href="/2026/11/07/where-did-50000-development-workers-go/">Read the special report</a>
    &nbsp; <a class="btn btn-outline" style="padding:14px 26px;font-size:16px" href="/survey/">Back to the survey</a></p>
    <p style="color:#6b6f76;font-size:15px;margin-top:24px">Survey link to share: https://devlensbd.pages.dev/survey/</p>
  </div>
</Base>
