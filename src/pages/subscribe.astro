---
// Subscribe: sign-up for the Devlens Brief, sent to MailerLite (group "Devlens Brief", double opt-in).
// Same card style as the Submit page, in a single column.
import Base from '../layouts/Base.astro';
import { home, openJobs, dhakaToday } from '../lib/data.js';

const action = 'https://assets.mailerlite.com/jsonp/2769076/forms/203227707079657299/subscribe';
const today = dhakaToday();

const open = openJobs(today);
const funding = (home.funding || []).filter((f) => !f.deadline || f.deadline >= today);

const perks = [
  ['01', 'Top stories', 'The week\'s most important news from NGOs, donors and the government, with links to the original sources.'],
  ['02', 'Jobs', `New vacancies at NGOs, INGOs and UN agencies, and the ones closing soon. ${open.length} open on the site now.`],
  ['03', 'Funding', `Open funding calls, tenders and expressions of interest. ${funding.length} with upcoming deadlines now.`],
  ['04', 'Research and data', 'New research, evaluations and key numbers on Bangladesh, explained in plain language.'],
];
const faqs = [
  ['Is it free?', 'Yes. The Devlens Brief is free and always will be for readers.'],
  ['Why do I need to confirm my email?', 'We send a confirmation link so nobody can sign you up without your permission. Your subscription starts when you click it. If you cannot find it, check your spam or promotions folder.'],
  ['How do I unsubscribe?', 'Every email has an unsubscribe link at the bottom. One click and you are off the list.'],
  ['What do you do with my details?', 'We use your email, and your first name if you give it, only to send the Devlens Brief. We do not sell or share them.'],
];
---
<Base title="Subscribe" description="The Devlens Brief: Bangladesh's development sector, open funding, jobs and new research, in your inbox. Free.">
  <header class="page-head"><div class="wrap">
    <p class="eyebrow" style="color:#0b8f68">The Devlens Brief</p>
    <h1>A clearer view, in your inbox</h1>
    <p class="sub-lede">What is happening in Bangladesh's development sector, plus open funding, jobs and new research. Free.</p>
  </div></header>

  <div class="wrap page-body">
    <div class="sub-grid">
      <div class="sub-form">
        <form id="brief-form" class="sub-card" action={action} method="post" target="_blank" novalidate>
          <h2><span>01</span> Sign up free</h2>
          <div class="sub-row">
            <div class="sub-field">
              <label for="f-email">Email address *</label>
              <input id="f-email" type="email" name="fields[email]" autocomplete="email" placeholder="you@example.org" required />
              <p class="sub-err" id="e-email"></p>
            </div>
            <div class="sub-field">
              <label for="f-name">First name (optional)</label>
              <input id="f-name" name="fields[name]" maxlength="60" autocomplete="given-name" placeholder="So we can say hello" />
            </div>
          </div>
          <input type="hidden" name="ml-submit" value="1" />
          <input type="hidden" name="anticsrf" value="true" />
          <label class="sub-check"><input type="checkbox" id="f-ok" /><span>I would like to receive the Devlens Brief by email. *</span></label>
          <p class="sub-err" id="e-ok"></p>
          <div class="sub-actions">
            <p class="sub-hint">Free. No spam. Unsubscribe any time.</p>
            <button type="submit" class="btn btn-green" id="brief-btn">Subscribe free</button>
          </div>
          <p class="brief-msg" id="brief-msg" role="status" hidden></p>
        </form>

        <div class="brief-done sub-card" id="brief-done" hidden>
          <h2><span>✓</span> Almost done</h2>
          <p>We have sent a confirmation link to <strong id="done-email"></strong>. Open it and click <strong>Confirm</strong> to start receiving the Brief.</p>
          <ol>
            <li>Can't see it? Check your spam or promotions folder.</li>
            <li>Add our sender address to your contacts so the Brief reaches your main inbox.</li>
            <li>Wrong address? <button type="button" class="linkish" id="brief-again">Sign up again</button></li>
          </ol>
        </div>

        <section class="sub-card">
          <h2><span>02</span> What you get</h2>
          <div class="brief-perks">
            {perks.map(([n, t, d]) => (
              <div class="brief-perk"><strong>{t}</strong><p>{d}</p></div>
            ))}
          </div>
        </section>

        <section class="sub-card">
          <h2><span>03</span> Questions</h2>
          <div class="brief-faq">
            {faqs.map(([q, a]) => (
              <details><summary>{q}</summary><p>{a}</p></details>
            ))}
          </div>
          <p class="sub-hint">Something else? Email <a href="mailto:devlensbangladesh@gmail.com">devlensbangladesh@gmail.com</a>. Want to send us news instead? <a href="/submit/">Share your work</a>.</p>
        </section>
      </div>

    </div>
  </div>
</Base>

<style is:global>
  .sub-lede { font-size: 20px; color: var(--ink-2); max-width: 760px; margin: 0; }
  .sub-grid { max-width: 760px; margin-top: 28px; }
  .sub-form { display: grid; gap: 22px; }
  .sub-card { border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; background: #fff; display: grid; gap: 16px; }
  .sub-card[hidden] { display: none; }
  .sub-card h2 { font-size: 19px; font-weight: 800; display: flex; align-items: center; gap: 10px; margin: 0; }
  .sub-card h2 span { background: var(--sand); color: var(--green-dark); font-size: 12px; border-radius: 8px; padding: 3px 7px; }
  .sub-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .sub-field { display: grid; gap: 6px; }
  .sub-field label { font-size: 14px; font-weight: 700; }
  .sub-hint { font-size: 13px; color: var(--faint); margin: 0; }
  .sub-hint a { color: var(--green-dark); }
  .sub-field input { width: 100%; font: 500 16px var(--font); color: var(--ink); background: var(--sand); border: 1.5px solid var(--line); border-radius: 12px; padding: 11px 14px; }
  .sub-field input:focus { outline: none; border-color: var(--green); background: #fff; }
  .sub-field .bad { border-color: var(--orange); }
  .sub-err { color: var(--orange); font-size: 13px; font-weight: 600; margin: 0; }
  .sub-err:empty { display: none; }
  .sub-check { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; color: var(--ink-2); cursor: pointer; }
  .sub-check input { margin-top: 4px; accent-color: var(--green-dark); width: 16px; height: 16px; }
  .sub-actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: space-between; align-items: center; }
  .sub-actions .btn { cursor: pointer; font-family: var(--font); border: 0; }
  .sub-actions .btn:disabled { opacity: .6; cursor: wait; }
  .brief-msg { margin: 0; font-weight: 700; color: var(--orange); }
  .brief-done p, .brief-done ol { margin: 0; color: var(--ink-2); font-size: 16px; overflow-wrap: anywhere; }
  .brief-done ol { padding-left: 20px; }
  .brief-done li { margin-bottom: 6px; }
  .linkish { background: none; border: 0; padding: 0; font: inherit; color: var(--green-dark); text-decoration: underline; cursor: pointer; }
  .brief-perks { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .brief-perk { background: var(--sand); border-radius: 12px; padding: 16px; }
  .brief-perk strong { font-size: 16px; }
  .brief-perk p { margin: 6px 0 0; font-size: 14px; color: var(--ink-2); }
  .brief-faq details { border-top: 1px solid var(--line); padding: 12px 0; }
  .brief-faq details:last-child { border-bottom: 1px solid var(--line); }
  .brief-faq summary { font-weight: 700; cursor: pointer; }
  .brief-faq p { margin: 8px 0 0; color: var(--ink-2); font-size: 15px; }
  @media (max-width: 560px) {
    .sub-row, .brief-perks { grid-template-columns: 1fr; }
    .sub-card { padding: 18px; }
    .sub-actions .btn { flex: 1 1 auto; text-align: center; }
  }
</style>

<script is:inline>
(function () {
  const $ = (id) => document.getElementById(id);
  const form = $('brief-form');
  const email = $('f-email'), name = $('f-name'), ok = $('f-ok'), btn = $('brief-btn'), msg = $('brief-msg');
  const valid = (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);


  function err(k, text) { $('e-' + k).textContent = text; const i = $('f-' + k); if (i && i.tagName === 'INPUT' && i.type !== 'checkbox') i.classList.toggle('bad', !!text); }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    let good = true;
    if (!valid(email.value.trim())) { err('email', 'Please enter a valid email address.'); good = false; } else err('email', '');
    if (!ok.checked) { err('ok', 'Please tick the box to confirm you want the Brief.'); good = false; } else err('ok', '');
    if (!good) return;
    if (!window.fetch) { form.submit(); return; }
    email.value = email.value.trim(); name.value = name.value.trim();
    btn.disabled = true; btn.textContent = 'Signing you up…'; msg.hidden = true;
    fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
      .then((r) => r.json().catch(() => ({})).then((j) => ({ ok: r.ok, j })))
      .then((res) => {
        if (res.ok && res.j.success !== false) {
          $('done-email').textContent = email.value;
          form.hidden = true; $('brief-done').hidden = false;
          $('brief-done').scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          msg.hidden = false; msg.textContent = 'That did not work. Please check the email address and try again.';
        }
      })
      .catch(() => { form.submit(); })
      .finally(() => { btn.disabled = false; btn.textContent = 'Subscribe free'; });
  });

  $('brief-again').addEventListener('click', () => { form.reset(); $('brief-done').hidden = true; form.hidden = false; email.focus(); });
})();
</script>
