---
import Base from '../../../../layouts/Base.astro';
import { posts, postUrl, catName, fmtDate, firstImage } from '../../../../lib/data.js';

export function getStaticPaths() {
  return posts.map((p) => {
    const [year, month, day] = p.date.slice(0, 10).split('-');
    return { params: { year, month, day, slug: p.slug }, props: { post: p } };
  });
}
const { post } = Astro.props;
const i = posts.findIndex((p) => p.slug === post.slug);
const score = (p) => (p.tags || []).filter((t) => (post.tags || []).includes(t) && t !== 'national').length * 2 + p.categories.filter((c) => post.categories.includes(c) && c !== 'news').length;
const related = posts.filter((p) => p.slug !== post.slug).map((p) => [score(p), p]).filter(([n]) => n > 0)
  .sort((a, b) => b[0] - a[0] || b[1].date.localeCompare(a[1].date)).slice(0, 3).map(([, p]) => p);
// Lazy-load every image in the story except the first one.
let imgN = 0;
const bodyHtml = post.content.replace(/<img(?![^>]*\bloading=)/g, (m) => (imgN++ === 0 ? '<img fetchpriority="high"' : '<img loading="lazy" decoding="async"'));
const words = post.content.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));
const url = new URL(postUrl(post), Astro.site).href;
const enc = encodeURIComponent;
const updated = post.modified && post.modified.slice(0, 10) !== post.date.slice(0, 10) ? post.modified : null;
const site = Astro.site.href.replace(/\/$/, '');
const kind = post.categories.includes('analysis') || /^Devlens (Analysis|Explainer)/.test(post.title) ? 'AnalysisNewsArticle'
  : /^Devlens Research Summary/.test(post.title) ? 'ReportageNewsArticle' : 'NewsArticle';
const sectionName = catName(post.categories.find((c) => c !== 'news') || post.categories[0] || 'news');
const ld = {
  '@context': 'https://schema.org', '@type': kind, headline: post.title.length > 110 ? post.title.slice(0, 107).replace(/\s+\S*$/, '') + '…' : post.title, description: post.excerpt,
  inLanguage: 'en', isAccessibleForFree: true, articleSection: sectionName, wordCount: words,
  keywords: (post.tags || []).map((t) => t.replace(/-/g, ' ')).join(', ') || undefined,
  about: { '@type': 'Place', name: 'Bangladesh' },
  datePublished: post.date + '+06:00', dateModified: (post.modified || post.date) + '+06:00', mainEntityOfPage: url,
  image: post.image ? [new URL(post.image.src, Astro.site).href] : undefined,
  author: { '@type': 'Organization', name: 'Devlens Bangladesh editorial team', url: site + '/about/' },
  publisher: { '@id': site + '/#organization' },
};
const crumbs = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site + '/' },
    { '@type': 'ListItem', position: 2, name: sectionName, item: `${site}/category/${post.categories.find((c) => c !== 'news') || post.categories[0] || 'news'}/` },
    { '@type': 'ListItem', position: 3, name: post.title, item: url },
  ],
};
const share = [
  ['LinkedIn', `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`],
  ['Facebook', `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`],
  ['X', `https://x.com/intent/post?url=${enc(url)}&text=${enc(post.title)}`],
  ['WhatsApp', `https://wa.me/?text=${enc(post.title + ' ' + url)}`],
  ['Email', `mailto:?subject=${enc(post.title)}&body=${enc(url)}`],
];
---
<Base title={post.title} description={post.excerpt} image={post.image?.src} imageAlt={post.image?.alt} type="article" published={post.date} modified={post.modified || post.date} section={sectionName} tags={(post.tags || []).map((t) => t.replace(/-/g, ' '))} wpBlocks>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(crumbs)} />
  <article>
    <header class="article-head">
      <div class="wrap">
        <p class="meta">
          {post.categories.map((c) => <a class="pill" style="font-size:11px" href={`/category/${c}/`}>{catName(c)}</a>)}
          <time datetime={post.date}>{fmtDate(post.date)}</time>
        </p>
        <h1>{post.title}</h1>
        {post.excerpt && <p class="standfirst">{post.excerpt}</p>}
        <p class="byline">By the Devlens Bangladesh editorial team · {minutes} min read{updated && <> · Updated {fmtDate(updated)}</>}</p>
      </div>
    </header>
    <div class="article-body">
      <div class="wrap">
        {post.image && !firstImage(post.content) && (
          <figure style="margin:0 0 1.5em"><img src={post.image.src} alt={post.image.alt} width={post.image.width} height={post.image.height} fetchpriority="high" style="border-radius:16px" />{post.image.credit ? <figcaption class="img-credit">Photo: {post.image.creditUrl ? <a href={post.image.creditUrl} rel="noopener">{post.image.credit}</a> : post.image.credit}</figcaption> : /AI-generated/i.test(post.image.alt || '') && <figcaption class="img-credit">AI-generated illustration</figcaption>}</figure>
        )}
        <div class="prose wp-content" set:html={bodyHtml} />
        <aside class="newsroom-box" aria-label="About Devlens Bangladesh">
          <img src="/favicon.svg" alt="" width="44" height="44" />
          <p><strong>Devlens Bangladesh</strong> is an independent newsroom in Dhaka covering the NGO, humanitarian and development sector. Every figure in this story is attributed to its source and linked where it is online. <a href="/editorial-standards/">How we report</a> · <a href="/about/">About us</a></p>
        </aside>
        <div class="share" aria-label="Share this story"><span>Share</span>{share.map(([n, h]) => <a href={h} target="_blank" rel="noopener">{n}</a>)}</div>
        <div class="article-foot">
          {post.tags?.length > 0 && <p>Topics: {post.tags.map((t, k) => <>{k > 0 && ' · '}<a href={`/tag/${t}/`}>{t.replace(/-/g, ' ')}</a></>)}</p>}
          <p>Spotted an error? <a href="/submit/">Tell us</a> and we will correct it. Read our <a href="/editorial-standards/">editorial standards</a>.</p>
        </div>
      </div>
    </div>
  </article>
  {related.length > 0 && (
    <section class="section sand">
      <div class="wrap">
        <div class="section-head"><h2>Related</h2></div>
        <div class="grid-3">
          {related.map((p) => (
            <article class="story">
              {p.image && <a href={postUrl(p)}><img src={p.image.src} alt={p.image.alt} loading="lazy" /></a>}
              <h3><a href={postUrl(p)}>{p.title}</a></h3>
              <span class="date">{fmtDate(p.date)}</span>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
