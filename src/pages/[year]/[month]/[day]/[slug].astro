---
import Base from '../../../../layouts/Base.astro';
import { posts, postUrl, catName, fmtDate, firstImage } from '../../../../lib/data.js';

export function getStaticPaths() {
  return posts.map((p) => {
    const [year, month, day] = p.date.slice(0, 10).split('-');
    return { params: { year, month, day, slug: p.slug }, props: { post: p } };
  });
}
const { post } = Astro.props;
const i = posts.findIndex((p) => p.slug === post.slug);
const score = (p) => (p.tags || []).filter((t) => (post.tags || []).includes(t) && t !== 'national').length * 2 + p.categories.filter((c) => post.categories.includes(c) && c !== 'news').length;
const related = posts.filter((p) => p.slug !== post.slug).map((p) => [score(p), p]).filter(([n]) => n > 0)
  .sort((a, b) => b[0] - a[0] || b[1].date.localeCompare(a[1].date)).slice(0, 3).map(([, p]) => p);
const words = post.content.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));
const url = new URL(postUrl(post), Astro.site).href;
const enc = encodeURIComponent;
const updated = post.modified && post.modified.slice(0, 10) !== post.date.slice(0, 10) ? post.modified : null;
const ld = {
  '@context': 'https://schema.org', '@type': 'NewsArticle', headline: post.title, description: post.excerpt,
  datePublished: post.date + '+06:00', dateModified: (post.modified || post.date) + '+06:00', mainEntityOfPage: url,
  image: post.image ? [new URL(post.image.src, Astro.site).href] : undefined,
  author: { '@type': 'Organization', name: 'Devlens Bangladesh', url: Astro.site.href },
  publisher: { '@type': 'Organization', name: 'Devlens Bangladesh', logo: { '@type': 'ImageObject', url: new URL('/media/2026/10/devlens-logo.png', Astro.site).href } },
};
const share = [
  ['LinkedIn', `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`],
  ['Facebook', `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`],
  ['X', `https://x.com/intent/post?url=${enc(url)}&text=${enc(post.title)}`],
  ['WhatsApp', `https://wa.me/?text=${enc(post.title + ' ' + url)}`],
  ['Email', `mailto:?subject=${enc(post.title)}&body=${enc(url)}`],
];
---
<Base title={post.title} description={post.excerpt} image={post.image?.src} wpBlocks>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <article>
    <header class="article-head">
      <div class="wrap">
        <p class="meta">
          {post.categories.map((c) => <a class="pill" style="font-size:11px" href={`/category/${c}/`}>{catName(c)}</a>)}
          <time datetime={post.date}>{fmtDate(post.date)}</time>
        </p>
        <h1>{post.title}</h1>
        {post.excerpt && <p class="standfirst">{post.excerpt}</p>}
        <p class="byline">By the Devlens Bangladesh editorial team · {minutes} min read{updated && <> · Updated {fmtDate(updated)}</>}</p>
      </div>
    </header>
    <div class="article-body">
      <div class="wrap">
        {post.image && !firstImage(post.content) && (
          <figure style="margin:0 0 1.5em"><img src={post.image.src} alt={post.image.alt} width={post.image.width} height={post.image.height} style="border-radius:16px" />{post.image.credit ? <figcaption class="img-credit">Photo: {post.image.creditUrl ? <a href={post.image.creditUrl} rel="noopener">{post.image.credit}</a> : post.image.credit}</figcaption> : /AI-generated/i.test(post.image.alt || '') && <figcaption class="img-credit">AI-generated illustration</figcaption>}</figure>
        )}
        <div class="prose wp-content" set:html={post.content} />
        <div class="share" aria-label="Share this story"><span>Share</span>{share.map(([n, h]) => <a href={h} target="_blank" rel="noopener">{n}</a>)}</div>
        <div class="article-foot">
          {post.tags?.length > 0 && <p>Topics: {post.tags.map((t, k) => <>{k > 0 && ' · '}<a href={`/tag/${t}/`}>{t.replace(/-/g, ' ')}</a></>)}</p>}
          <p>Spotted an error? <a href="/submit/">Tell us</a> and we will correct it. Read our <a href="/editorial-standards/">editorial standards</a>.</p>
        </div>
      </div>
    </div>
  </article>
  {related.length > 0 && (
    <section class="section sand">
      <div class="wrap">
        <div class="section-head"><h2>Related</h2></div>
        <div class="grid-3">
          {related.map((p) => (
            <article class="story">
              {p.image && <a href={postUrl(p)}><img src={p.image.src} alt={p.image.alt} loading="lazy" /></a>}
              <h3><a href={postUrl(p)}>{p.title}</a></h3>
              <span class="date">{fmtDate(p.date)}</span>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
