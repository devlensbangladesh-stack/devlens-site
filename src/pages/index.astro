---
import Base from '../layouts/Base.astro';
import SignupForm from '../components/SignupForm.astro';
import { posts, home, jobsData, bySlug, postUrl, catName, fmtDate, dhakaToday, openJobs, jobLabel, daysBetween } from '../lib/data.js';

const today = dhakaToday();
const lead = bySlug(home.lead.slug);
const also = bySlug(home.alsoToday.slug);
const plusAll = (home.alsoToday.plus || []).map(bySlug).filter(Boolean);
const plus = plusAll.slice(0, 6);
const jobs = openJobs(today);
const sectorCounts = jobsData.sectors
  .map((s) => ({ ...s, n: jobs.filter((j) => j.sector === s.id).length }))
  .filter((s) => s.n > 0)
  .sort((a, b) => b.n - a.n);
const shortName = { 'Food security and agriculture': 'Food security', 'Governance and digital': 'Governance', 'Climate and environment': 'Climate', 'Livelihoods and microfinance': 'Livelihoods' };
const featured = jobs.filter((j) => j.featured).slice(0, 3);


const soonJobs = jobs.filter((j) => j.deadline).map((j) => ({ kind: 'Job', title: j.title, org: `${j.org} · ${j.location}`, url: j.url, deadline: j.deadline }));
const soonFunding = (home.funding || []).filter((f) => f.deadline >= today).map((f) => ({ kind: 'Funding', title: f.title, org: f.funder, url: f.url, deadline: f.deadline }));
const soon = [...soonJobs, ...soonFunding].sort((a, b) => a.deadline.localeCompare(b.deadline)).slice(0, 4);
const dayMonth = (iso) => { const d = new Date(iso + 'T12:00:00Z'); return [d.getUTCDate(), d.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' })]; };
// Devlens Special section: the newest special as a news card, older ones as links (owner request, 27 Nov 2026).
const specialPosts = posts.filter((p) => p.categories.includes('devlens-special'));
// When today's lead is itself the newest Special, feature the previous Special so the same photo isn't shown twice.
const specialPool = specialPosts.filter((p) => p.slug !== home.lead.slug);
const specialLatest = specialPool[0];
const specialOlder = specialPool.slice(1, 6);
const leadImg = lead?.image?.src;
const spot = home.spotlight;
const spotOn = spot && today >= spot.start && today <= spot.until;
const spotStories = spotOn ? (spot.stories || []).map(bySlug).filter(Boolean).sort((a, b) => b.date.localeCompare(a.date)) : [];
const spotHelp = spotOn ? (spot.links || []).filter((l) => /^tel:/.test(l.url)) : [];
const spotFollow = spotOn ? (spot.links || []).filter((l) => !/^tel:/.test(l.url)) : [];
const spotStatsAll = spotOn && spot.data ? spot.data.items : [];
const spotStatsTop = spotStatsAll.filter((d) => d.highlight).length ? spotStatsAll.filter((d) => d.highlight).slice(0, 4) : spotStatsAll.slice(0, 4);
const spotStatsMore = spotStatsAll.filter((d) => !spotStatsTop.includes(d));
const splitWatch = (w) => { const i = w.indexOf(':'); const cap = (t) => t.charAt(0).toUpperCase() + t.slice(1); return i > 0 && i < 40 ? [w.slice(0, i), cap(w.slice(i + 1).trim())] : ['', w]; };
const srcList = (arr) => (arr || []).filter((s) => s && s.url);
const spotDay = spotOn ? daysBetween(spot.start, today) + 1 : 0;
---
<Base description="Daily news, jobs, funding calls, research and data for Bangladesh's NGO, humanitarian and development sector. Updated every morning and afternoon.">
  {lead && (
    <section class="lead">
      {leadImg && <img class="bg" src={leadImg} alt={lead.image.alt} width={lead.image.width} height={lead.image.height} fetchpriority="high" />}
      <div class="wrap">
        <div class="lead-inner">
          <span class="pill">Lead story · {home.lead.label}</span>
          <h1><a href={postUrl(lead)}>{home.lead.headline || lead.title}</a></h1>
          <p>{home.lead.summary || lead.excerpt}</p>
          <div class="actions">
            <a class="btn btn-light" href={postUrl(lead)}>Read the story</a>
            <a class="btn btn-ghost" href="/submit/">Share your work</a>
          </div>
        </div>
      </div>
    </section>
  )}

  {spotOn && (
    <section id="spotlight" class={`spotlight spot-v2${spot.theme ? ` theme-${spot.theme}` : ""}`} data-spot-start={spot.start} data-spot-until={spot.until} data-spot-days={spot.days}>
      <div class="wrap">
        <div class="spot-top">
          <div class="spot-title">
            <p class="label">{spot.label} · <span data-spot-day>Day {spotDay} of {spot.days}</span></p>
            <h2>{spot.title}</h2>
            <p class="dates">{spot.tagline || spot.dates}</p>
            <div class="spot-progress" aria-hidden="true"><span style={`width:${Math.min(100, Math.round((spotDay / spot.days) * 100))}%`}></span></div>
          </div>
          {spotHelp.length > 0 && (
            <div class="spot-help">
              <p>{spot.helpLabel || 'Need help now?'}</p>
              <div>{spotHelp.map((l) => <a href={l.url}>{l.label}</a>)}</div>
            </div>
          )}
        </div>
        <div class="spot-cols">
          {spot.today && (
            <div class="spot-card spot-today">
              <p class="kicker">{spot.todayLabel || 'Today'} · {spot.today.date}</p>
              {spot.today.headline && <h3 class="spot-today-h">{spot.today.headline}</h3>}
              <p>{spot.today.text}</p>
              {srcList(spot.today.sources || [{ name: spot.today.source, url: spot.today.url }]).length > 0 && (
                <p class="src">Sources: {srcList(spot.today.sources || [{ name: spot.today.source, url: spot.today.url }]).map((s, i) => <>{i > 0 && ' · '}<a href={s.url} rel="noopener">{s.name}</a></>)}</p>
              )}
            </div>
          )}
          {spot.data && (
            <div class="spot-card spot-stats">
              <p class="kicker">{spot.data.title}</p>
              <div class="spot-tiles">
                {spotStatsTop.map((d) => (
                  <a class="spot-tile" href={d.url} rel="noopener" title={`Source: ${d.source}`}>
                    <b>{d.display || `${d.value}%`}</b>
                    <span>{d.short || d.label}</span>
                  </a>
                ))}
              </div>
              {spotStatsMore.length > 0 && (
                <details class="spot-more">
                  <summary>{spotStatsMore.length} more {spotStatsMore.length === 1 ? 'figure' : 'figures'}</summary>
                  <ul class="spot-figs">{spotStatsMore.map((d) => <li><b>{d.display || `${d.value}%`}</b> <a href={d.url} rel="noopener">{d.label}</a></li>)}</ul>
                </details>
              )}
              <p class="src">Tap a figure for its source. {spot.data.note || ''}</p>
            </div>
          )}
          {spotStories.length > 0 && (
            <div class="spot-card spot-cover">
              <p class="kicker">Devlens coverage · {spotStories.length} {spotStories.length === 1 ? 'story' : 'stories'}</p>
              <a class="spot-feature" href={postUrl(spotStories[0])}>
                {spotStories[0].image && <img src={spotStories[0].image.src} alt={spotStories[0].image.alt || ''} width="640" height="360" loading="lazy" />}
                <strong>{spotStories[0].title}</strong>
                <span>{fmtDate(spotStories[0].date)}</span>
              </a>
              <ul class="spot-stories">
                {spotStories.slice(1, 3).map((p) => <li><a href={postUrl(p)}>{p.title}</a><span>{fmtDate(p.date)}</span></li>)}
              </ul>
              {spotStories.length > 3 && (
                <details class="spot-more">
                  <summary>Show {spotStories.length - 3} earlier {spotStories.length - 3 === 1 ? 'story' : 'stories'}</summary>
                  <ul class="spot-stories">{spotStories.slice(3).map((p) => <li><a href={postUrl(p)}>{p.title}</a><span>{fmtDate(p.date)}</span></li>)}</ul>
                </details>
              )}
            </div>
          )}
        </div>
        {spotFollow.length > 0 && (
          <div class="spot-follow"><span>{spot.followLabel || 'Follow the campaign'}</span><ul class="spot-links">{spotFollow.map((l) => <li><a href={l.url} rel="noopener">{l.label} ↗</a></li>)}</ul></div>
        )}
      </div>
    </section>
  )}

  {also && (
    <section class="also">
      <div class="wrap">
        <div class="also-main">
          {also.image && <a class="also-img" href={postUrl(also)}><img src={also.image.src} alt={also.image.alt} width="640" height="360" loading="lazy" /></a>}
          <div class="also-text">
            <p class="label">Also today · {home.alsoToday.label}</p>
            <h2><a href={postUrl(also)}>{home.alsoToday.headline || also.title}</a></h2>
            <p>{home.alsoToday.summary || also.excerpt}</p>
            <a class="btn btn-green" href={postUrl(also)}>Read the story</a>
          </div>
        </div>
        {plus.length > 0 && (
          <div class="also-more">
            <div class="also-more-head"><p class="label">More from today</p><a href="/category/news/">All stories ↗</a></div>
            <ul>
              {plus.map((p) => (
                <li>
                  <span class="meta">{catName(p.categories[0] || 'news')}</span>
                  <a href={postUrl(p)}>{p.title}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <section class="uses" aria-labelledby="uses-h">
    <div class="wrap">
      <div class="uses-head">
        <div>
          <p class="eyebrow">One place for the sector</p>
          <h2 id="uses-h">What you can do on Devlens</h2>
        </div>
        <a class="uses-guide" href="/how-to-use/">New here? How to use Devlens →</a>
      </div>
      <div class="uses-grid">
        <a href="/jobs/"><strong data-open-jobs>{jobs.length}</strong><b>Find a job</b><span>NGO, INGO and UN roles, checked against the employer's own advert</span></a>
        <a href="/funding/"><strong>{home.pills.fundingOpen}</strong><b>Find funding</b><span>Open grants, tenders and EOIs with deadlines and links to the call</span></a>
        <a href="/research-evidence/"><strong>{home.pills.newReports}</strong><b>Read the evidence</b><span>New research and reports explained in plain words</span></a>
        <a href="/data/"><strong>{home.pills.keyNumbers}</strong><b>Check the numbers</b><span>Key figures on Bangladesh, each with its source and date</span></a>
      </div>
    </div>
  </section>

  <section class="jobs-band">
    <div class="wrap jobs-grid">
      <div class="jobs-intro">
        <span class="pill">Jobs and careers</span>
        <h2><span><span data-open-jobs>{jobs.length}</span> open roles</span> at NGOs, INGOs and UN agencies</h2>
        <p class="intro">Collected every day from employer career sites, Impactpool, ReliefWeb, LinkedIn and Bangla newspaper job circulars. Every listing shows its official reference and links straight to the advert.</p>
        <p class="chips-dark">
          {sectorCounts.slice(0, 5).map((s) => <a href={`/jobs/#${s.id}`}>{shortName[s.name] || s.name} · <span data-sector-count={s.id}>{s.n}</span></a>)}
          {sectorCounts.length > 5 && <a class="more" href="/jobs/">+{sectorCounts.length - 5} more sectors</a>}
        </p>
        <div class="actions">
          <a class="btn btn-green" href="/jobs/">Browse all jobs ↗</a>
          <a class="btn btn-ghost" href="/submit/">List a vacancy for free</a>
        </div>
      </div>
      {featured.length > 0 && (
        <div class="jobs-featured">
          <p class="eyebrow">Featured roles</p>
          <ul>
            {featured.map((j) => {
              const lab = jobLabel(j.deadline, today);
              return (
                <li data-job-deadline={j.deadline || ''}>
                  <a href={j.url}>
                    <span class="tag">{j.featured}</span>
                    <strong>{j.title}</strong>
                    <span class="org"><b>{j.org}</b> · {j.location}</span>
                    <span class="when">{j.deadline ? `${lab.text === 'CLOSES TODAY' ? 'Closes today, ' : 'Closes '}${fmtDate(j.deadline)}` : 'Deadline: see advert'}</span>
                  </a>
                </li>
              );
            })}
          </ul>
          <a class="all" href="/jobs/">See all {jobs.length} open roles →</a>
        </div>
      )}
    </div>
  </section>

  {specialLatest && (
    <section class="section special">
      <div class="wrap">
        <div class="section-head"><h2><span style="color:#12b886">■</span> Devlens Special</h2><a href="/category/devlens-special/">All special reports ↗</a></div>
        <div class="special-wrap">
          <article class="special-latest">
            {specialLatest.image && <a class="img" href={postUrl(specialLatest)}><img src={specialLatest.image.src} alt={specialLatest.image.alt} width="1280" height="720" loading="lazy" /></a>}
            <div class="text">
              <p class="eyebrow" style="color:#0b8f68">Latest special · {fmtDate(specialLatest.date)}</p>
              <h3><a href={postUrl(specialLatest)}>{specialLatest.title}</a></h3>
              <p>{specialLatest.excerpt}</p>
              <a class="more" href={postUrl(specialLatest)}>Read the special report →</a>
            </div>
          </article>
          {specialOlder.length > 0 && (
            <aside class="special-prev">
              <p class="eyebrow">Earlier specials</p>
              <ul>{specialOlder.map((p) => <li><a href={postUrl(p)}>{p.title}</a><span>{fmtDate(p.date)}</span></li>)}</ul>
            </aside>
          )}
        </div>
      </div>
    </section>
  )}

  <section class="section sand">
    <div class="wrap">
      <div class="section-head"><h2>By the numbers</h2><a href="/data/">Explore the data ↗</a></div>
      <div class="grid-3">
        {home.numbers.map((n) => {
          const c = n.compare;
          const max = c ? Math.max(c.before, c.now) : 0;
          return (
            <div class="number">
              <strong>{n.value}</strong>
              <span>{n.label}</span>
              {c && (
                <div class="num-chart" role="img" aria-label={`${c.beforeLabel}: ${c.beforeText || c.before}; ${c.nowLabel}: ${c.nowText || c.now}`}>
                  <div class="num-row"><em>{c.beforeLabel}</em><i style={`width:${Math.round((c.before / max) * 100)}%`}></i><b>{c.beforeText || c.before}</b></div>
                  <div class="num-row now"><em>{c.nowLabel}</em><i style={`width:${Math.round((c.now / max) * 100)}%`}></i><b>{c.nowText || c.now}</b></div>
                </div>
              )}
              <small>{n.source}</small>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>Closing soon</h2><a href="/jobs/#closing-soon">All opportunities ↗</a></div>
      <div class="grid-4" id="home-soon">
        {soon.map((s) => {
          const [d, m] = dayMonth(s.deadline);
          const col = s.kind === 'Funding' ? '#12b886' : '#ff6b4a';
          return (
            <a class="soon-card" href={s.url} data-job-deadline={s.deadline}>
              <span class="date-badge" style={`background:${col}`}><b>{d}</b><small>{m}</small></span>
              <span class="kind" style={`color:${col}`}>{s.kind}</span>
              <h3>{s.title}</h3>
              <p>{s.org}</p>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="newsletter">
        <div><h2>A clearer view, in your inbox</h2><p>Top stories, open funding and jobs from Bangladesh's development sector. Free.</p></div>
        <SignupForm />
      </div>
    </div>
  </section>
  <script is:inline>
    (function () {
      var s = document.querySelector('[data-spot-until]'); if (!s) return;
      var t = new Date(Date.now() + 6 * 3600e3).toISOString().slice(0, 10);
      if (t > s.dataset.spotUntil || t < s.dataset.spotStart) { s.remove(); return; }
      var n = Math.round((Date.parse(t) - Date.parse(s.dataset.spotStart)) / 864e5) + 1;
      var d = s.querySelector('[data-spot-day]'); if (d) d.textContent = 'Day ' + n + ' of ' + s.dataset.spotDays;
    })();
  </script>
  <script type="application/json" id="jobs-data" set:html={JSON.stringify(jobsData.jobs.map((j) => ({ s: j.sector, d: j.deadline })))} />
</Base>
