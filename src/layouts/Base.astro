---
import '../styles/site.css';
import { dhakaToday } from '../lib/data.js';
import homeData from '../data/home.json';
const { title, description = 'News, funding, jobs, research and data for Bangladesh\'s development and humanitarian sector.', image, wpBlocks = false } = Astro.props;
const fullTitle = title ? `${title} | Devlens Bangladesh` : 'Devlens Bangladesh | Development intelligence for Bangladesh';
const today = dhakaToday();
const d = new Date(today + 'T12:00:00Z');
const weekday = d.toLocaleDateString('en-GB', { weekday: 'long', timeZone: 'UTC' });
const longDate = d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const canonical = new URL(Astro.url.pathname, Astro.site);
const strip = homeData.spotlight && homeData.spotlight.strip && today >= homeData.spotlight.start && today <= homeData.spotlight.until ? homeData.spotlight : null;
const stripDay = strip ? Math.round((Date.parse(today) - Date.parse(strip.start)) / 86400000) + 1 : 0;
const ogImage = image ? new URL(image, Astro.site) : null;
const nav = [
  ['News', '/category/news/'], ['Sectors', '/sectors/'], ['Research', '/research-evidence/'], ['Funding', '/funding/'],
  ['Jobs', '/jobs/'], ['Data', '/data/'], ['Events', '/events/'], ['Resources', '/resources/'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <script is:inline>
    // Domain lock: if this page is served from a copied or mirrored site, send the reader to the real Devlens page.
    (function () {
      var h = location.hostname, home = 'https://devlensbd.org';
      var dest = home + location.pathname + location.search + location.hash;
      // The main Pages address and www move to devlensbd.org; preview builds and local testing stay put.
      if (h === 'devlensbd.org' || /\.devlensbd\.pages\.dev$/.test(h) || h === 'localhost' || h === '127.0.0.1') return;
      try { top.location.replace(dest); } catch (e) { location.replace(home + '/'); }
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="author" content="Devlens Bangladesh" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:site_name" content="Devlens Bangladesh" />
  <meta property="og:title" content={title || 'Devlens Bangladesh'} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="Devlens Bangladesh" href="/feed.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  {wpBlocks && <link rel="stylesheet" href="/wp-blocks.css" />}
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-row">
      <div class="brand">
        <a href="/" class="logo"><img src="/media/2026/10/devlens-logo.png" alt="Devlens Bangladesh" width="148" height="40" /><span class="beta" title="Devlens is in beta">Beta</span></a>
        <p class="today" id="today-date">{weekday}<br />{longDate}</p>
      </div>
      <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
      <nav id="site-nav" class="site-nav" aria-label="Main">
        {nav.map(([label, href]) => <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined}>{label}</a>)}
      </nav>
      <div class="header-actions">
        <a class="btn btn-outline" href="/submit/">Share your work</a>
        <a class="btn btn-dark" href="/subscribe/">Subscribe</a>
      </div>
    </div>
  </header>
  {strip && (
    <div class={`spot-strip theme-${strip.theme || 'green'}`} data-strip-start={strip.start} data-strip-until={strip.until} data-strip-days={strip.days}>
      <div class="wrap">
        <span class="tag">{strip.title}</span>
        <span class="day" data-strip-day>Day {stripDay} of {strip.days}</span>
        <a class="msg" href={strip.strip.url}>{strip.strip.text} →</a>
        {strip.strip.help && <a class="help" href={strip.strip.helpUrl}>{strip.strip.help}</a>}
      </div>
    </div>
  )}
  <script is:inline>
    (function () { var s = document.querySelector('[data-strip-until]'); if (!s) return;
      var t = new Date(Date.now() + 6 * 3600000).toISOString().slice(0, 10);
      if (t > s.dataset.stripUntil || t < s.dataset.stripStart) { s.remove(); return; }
      var n = Math.round((Date.parse(t) - Date.parse(s.dataset.stripStart)) / 86400000) + 1;
      var d = s.querySelector('[data-strip-day]'); if (d) d.textContent = 'Day ' + n + ' of ' + s.dataset.stripDays; })();
  </script>

  <main id="main"><slot /></main>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div class="footer-about">
        <a href="/"><img src="/media/2026/10/devlens-logo-white.png" alt="Devlens Bangladesh" width="180" height="48" /></a>
        <p class="tagline">Development intelligence for Bangladesh</p>
        <p>A clearer view of Bangladesh's development sector. News, funding, jobs, research and data, independently curated. Coverage cannot be bought; sponsored content is always labelled.</p>
        <p class="eyebrow">Follow Devlens</p>
        <p class="social">
          <a href="https://www.facebook.com/profile.php?id=61596271460489" rel="noopener" target="_blank">Facebook</a>
          <a href="https://www.linkedin.com/company/144052802/" rel="noopener" target="_blank">LinkedIn</a>
          <a href="https://www.youtube.com/@DevLensBangladesh" rel="noopener" target="_blank">YouTube</a>
        </p>
        <p><a href="mailto:devlensbangladesh@gmail.com">devlensbangladesh@gmail.com</a></p>
        <address class="footer-address">House 60, Road 3, Block B, Niketon, Gulshan, Dhaka 1212, Bangladesh · <a href="https://www.google.com/maps?q=23.774074,90.412588" rel="noopener" target="_blank">Map</a></address>
      </div>
      <div><p class="eyebrow">Explore</p>
        <a href="/category/news/">News</a><a href="/sectors/">Sectors</a><a href="/research-evidence/">Research</a><a href="/funding/">Funding</a><a href="/jobs/">Jobs</a><a href="/data/">Data</a></div>
      <div><p class="eyebrow">More</p>
        <a href="/events/">Events</a><a href="/resources/">Resources</a><a href="/category/analysis/">Analysis</a><a href="/category/devlens-special/">Devlens Special</a></div>
      <div><p class="eyebrow">Devlens</p>
        <a href="/about/">About</a><a href="/editorial-standards/">Editorial standards</a><a href="/submit/">Share your work</a><a href="/for-ngos/">For NGOs</a><a href="/advertise/">Advertise and partner</a><a href="/subscribe/">Subscribe</a></div>
    </div>
    <div class="wrap"><p class="copyright">© {today.slice(0, 4)} Devlens Bangladesh · Dhaka</p></div>
  </footer>
  <script src="/devlens.js" defer></script>
</body>
</html>
