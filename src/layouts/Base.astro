---
import '../styles/site.css';
import { dhakaToday } from '../lib/data.js';
import homeData from '../data/home.json';
import SocialLinks from '../components/SocialLinks.astro';
const { title, description: rawDesc = 'News, funding, jobs, research and data for Bangladesh\'s development and humanitarian sector, updated every day.', image, imageAlt, wpBlocks = false, type = 'website', published, modified, noindex = false, section, tags = [] } = Astro.props;
// Keep titles short enough for search results: add the brand only when it fits in about 65 characters.
const fullTitle = !title ? 'Devlens Bangladesh: NGO news, jobs and funding in Bangladesh'
  : title.length <= 44 ? `${title} | Devlens Bangladesh`
  : title.length <= 55 ? `${title} | Devlens`
  : title;
// Meta descriptions: plain text, cut at a word boundary under 160 characters.
const plain = (rawDesc || '').replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
const description = plain.length <= 158 ? plain : plain.slice(0, 155).replace(/\s+\S*$/, '').replace(/[,;:.\s]+$/, '') + '…';
const today = dhakaToday();
const d = new Date(today + 'T12:00:00Z');
const weekday = d.toLocaleDateString('en-GB', { weekday: 'long', timeZone: 'UTC' });
const longDate = d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const canonical = new URL(Astro.url.pathname, Astro.site);
const strip = homeData.spotlight && homeData.spotlight.strip && today >= homeData.spotlight.start && today <= homeData.spotlight.until ? homeData.spotlight : null;
const stripDay = strip ? Math.round((Date.parse(today) - Date.parse(strip.start)) / 86400000) + 1 : 0;
const ogImage = new URL(image || '/media/2026/11/devlens-share-card.jpg', Astro.site);
const siteUrl = Astro.site.href.replace(/\/$/, '');
const orgLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'NewsMediaOrganization', '@id': siteUrl + '/#organization', name: 'Devlens Bangladesh', alternateName: 'Devlens',
      url: siteUrl + '/', logo: { '@type': 'ImageObject', url: siteUrl + '/media/2026/10/devlens-logo.png', width: 148, height: 40 },
      description: 'Development intelligence for Bangladesh: news, jobs, funding, research and data for the NGO, humanitarian and development sector.',
      email: 'devlensbangladesh@gmail.com', foundingLocation: 'Dhaka, Bangladesh', areaServed: 'Bangladesh',
      address: { '@type': 'PostalAddress', streetAddress: 'House 60, Road 3, Block B, Niketon, Gulshan', addressLocality: 'Dhaka', postalCode: '1212', addressCountry: 'BD' },
      sameAs: ['https://www.facebook.com/profile.php?id=61596271460489', 'https://www.linkedin.com/company/144052802/', 'https://www.youtube.com/@DevLensBangladesh'],
      publishingPrinciples: siteUrl + '/editorial-standards/', correctionsPolicy: siteUrl + '/editorial-standards/',
    },
    { '@type': 'WebSite', '@id': siteUrl + '/#website', url: siteUrl + '/', name: 'Devlens Bangladesh', inLanguage: 'en', publisher: { '@id': siteUrl + '/#organization' } },
  ],
};
const iso = (d) => (d && d.length <= 19 ? d + '+06:00' : d);
const nav = [
  ['News', '/category/news/'], ['Sectors', '/sectors/'], ['Research', '/research-evidence/'], ['Funding', '/funding/'],
  ['Jobs', '/jobs/'], ['Data', '/data/'], ['Events', '/events/'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <script is:inline>
    // Domain lock: if this page is served from a copied or mirrored site, send the reader to the real Devlens page.
    (function () {
      var h = location.hostname, home = 'https://devlensbd.org';
      var dest = home + location.pathname + location.search + location.hash;
      // The main Pages address and www move to devlensbd.org; preview builds and local testing stay put.
      if (h === 'devlensbd.org' || /\.devlensbd\.pages\.dev$/.test(h) || h === 'localhost' || h === '127.0.0.1') return;
      try { top.location.replace(dest); } catch (e) { location.replace(home + '/'); }
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="author" content="Devlens Bangladesh" />
  <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1808699527653627"
     crossorigin="anonymous"></script>
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
  <link rel="canonical" href={canonical} />
  <meta property="og:site_name" content="Devlens Bangladesh" />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title || 'Devlens Bangladesh'} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
  {type === 'article' && published && <meta property="article:published_time" content={iso(published)} />}
  {type === 'article' && modified && <meta property="article:modified_time" content={iso(modified)} />}
  {type === 'article' && section && <meta property="article:section" content={section} />}
  {type === 'article' && tags.map((t) => <meta property="article:tag" content={t} />)}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title || 'Devlens Bangladesh'} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="Devlens Bangladesh" href="/feed.xml" />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet" />
  {wpBlocks && <link rel="stylesheet" href="/wp-blocks.css" />}
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-row">
      <div class="brand">
        <a href="/" class="logo"><img src="/media/2026/10/devlens-logo.png" alt="Devlens Bangladesh" width="148" height="40" /><span class="beta" title="Devlens is in beta">Beta</span></a>
        <p class="today" id="today-date">{weekday}<br />{longDate}</p>
      </div>
      <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
      <nav id="site-nav" class="site-nav" aria-label="Main">
        {nav.map(([label, href]) => <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined}>{label}</a>)}
        <span class="nav-cta"><a class="btn btn-outline" href="/submit/">Share your work</a><a class="btn btn-dark" href="/subscribe/">Subscribe</a></span>
      </nav>
      <div class="header-actions">
        <a class="search-toggle" href="/search/" aria-controls="site-search" aria-expanded="false" title="Search Devlens">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
          <span class="sr-only">Search</span>
        </a>
        <a class="btn btn-outline" href="/submit/">Share your work</a>
        <a class="btn btn-dark" href="/subscribe/">Subscribe</a>
      </div>
    </div>
    <div id="site-search" class="search-bar" hidden>
      <form class="wrap search-form" action="/search/" method="get" role="search">
        <label for="site-search-q" class="sr-only">Search Devlens</label>
        <input id="site-search-q" type="search" name="q" placeholder="Search stories, jobs, funding" autocomplete="off" required />
        <button class="btn btn-dark" type="submit">Search</button>
      </form>
    </div>
  </header>
  {strip && (
    <div class={`spot-strip theme-${strip.theme || 'green'}`} data-strip-start={strip.start} data-strip-until={strip.until} data-strip-days={strip.days}>
      <div class="wrap">
        <span class="tag">{strip.title}</span>
        <span class="day" data-strip-day>Day {stripDay} of {strip.days}</span>
        <a class="msg" href={strip.strip.url}>{strip.strip.text} →</a>
        {strip.strip.help && <a class="help" href={strip.strip.helpUrl}>{strip.strip.help}</a>}
      </div>
    </div>
  )}
  <script is:inline>
    (function () { var s = document.querySelector('[data-strip-until]'); if (!s) return;
      var t = new Date(Date.now() + 6 * 3600000).toISOString().slice(0, 10);
      if (t > s.dataset.stripUntil || t < s.dataset.stripStart) { s.remove(); return; }
      var n = Math.round((Date.parse(t) - Date.parse(s.dataset.stripStart)) / 86400000) + 1;
      var d = s.querySelector('[data-strip-day]'); if (d) d.textContent = 'Day ' + n + ' of ' + s.dataset.stripDays; })();
  </script>

  <main id="main"><slot /></main>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div class="footer-about">
        <a href="/" class="footer-logo"><img src="/media/2026/10/devlens-logo-white.png" alt="Devlens Bangladesh" width="180" height="48" /><span class="beta">Beta</span></a>
        <p class="tagline">Development intelligence for Bangladesh</p>
        <p>News, jobs, funding, research and data for the NGO, humanitarian and development sector, checked against the original sources. Coverage cannot be bought; sponsored content is always labelled.</p>
        <SocialLinks email={false} />
      </div>
      <nav aria-label="Read"><p class="eyebrow">Read</p>
        <a href="/category/news/">News</a><a href="/category/analysis/">Analysis</a><a href="/category/devlens-special/">Devlens Special</a><a href="/research-evidence/">Research</a><a href="/data/">Data</a><a href="/sectors/">Sectors</a></nav>
      <nav aria-label="Opportunities"><p class="eyebrow">Opportunities</p>
        <a href="/jobs/">Jobs</a><a href="/funding/">Funding</a><a href="/events/">Events</a><a href="/resources/">Resources</a></nav>
      <nav aria-label="Use Devlens"><p class="eyebrow">Use Devlens</p>
        <a href="/how-to-use/">How to use Devlens</a><a href="/search/">Search</a><a href="/submit/">Share your work</a><a href="/for-ngos/">For NGOs</a><a href="/subscribe/">Newsletter</a></nav>
      <nav aria-label="About Devlens"><p class="eyebrow">Devlens</p>
        <a href="/about/">About</a><a href="/editorial-standards/">Editorial standards</a><a href="/advertise/">Advertise and partner</a><a href="mailto:devlensbangladesh@gmail.com">Contact us</a></nav>
    </div>
    <div class="wrap"><div class="footer-bottom">
      <p class="copyright">© {today.slice(0, 4)} Devlens Bangladesh</p>
      <address class="footer-address">House 60, Road 3, Block B, Niketon, Gulshan, Dhaka 1212 · <a href="https://www.google.com/maps?q=23.774074,90.412588" rel="noopener" target="_blank">Map</a></address>
    </div></div>
  </footer>
  <script src="/devlens.js" defer></script>
</body>
</html>
