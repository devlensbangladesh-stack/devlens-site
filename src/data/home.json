  "spotlight": {
    "id": "16days-2026",
    "start": "2026-11-25",
    "until": "2026-12-10",
    "days": 16,
    "theme": "orange",
    "label": "Spotlight",
    "title": "16 Days of Activism",
    "dates": "25 November to 10 December 2026 · Ensure justice, protect survivors, end impunity",
    "intro": "Three in four women in Bangladesh have faced violence from a partner, yet few cases reach a court and fewer end in a conviction. Devlens follows the campaign against gender-based violence every day until Human Rights Day.",
    "image": {
      "src": "/media/2026/11/photo-16-days-activism-2026-national-dialogue-dhaka.jpg",
      "alt": "Women and Children Affairs Minister A Z M Zahid Hossain speaks at the 16 Days of Activism national dialogue in Dhaka on 25 November 2026, in front of an orange campaign backdrop",
      "credit": "Photo: Press Information Department, via Wikimedia Commons (public domain)",
      "creditUrl": "https://commons.wikimedia.org/wiki/File:Abu_Zafar_Md._Zahid_Hussain_at_16_Days_of_Activism_Against_Gender-Based_Violence_program_in_Tejgaon_Dhaka_2026-11-25.jpg"
    },
    "todayLabel": "Today in the campaign",
    "today": {
      "date": "26 Nov",
      "text": "The campaign opened in Dhaka on Wednesday with a national dialogue organised by the UN, the Ministry of Women and Children Affairs and development partners, under the theme \"Ensure justice, protect survivors, end impunity\". Acting UN Resident Coordinator Carol Flore-Smereczniak said \"laws alone will not be enough\" and called for accountability, reliable data and money for survivor-centred justice. New figures released as the campaign began show the scale of the gap: police recorded 887 dowry murder cases in five years, Odhikar has counted 21,627 rape victims since 2001, more than half of them girls, and research cited at a Manusher Jonno Foundation dialogue found tribunals convicted in only 3% of 4,040 cases studied.",
      "sources": [
        {
          "name": "The Daily Star",
          "url": "https://www.thedailystar.net/news/bangladesh/rights/news/stronger-legal-frameworks-effective-enforcement-laws-needed-end-gender-violence-speakers-4333086"
