---
// Linked social icons, used in the footer and on the About page.
const { email = true, label = 'Follow Devlens', tone = 'dark' } = Astro.props;
const links = [
  ['Facebook', 'https://www.facebook.com/profile.php?id=61596271460489', '<path d="M14 8h3V4h-3c-2.76 0-5 2.24-5 5v2H7v4h2v9h4v-9h3l1-4h-4V9c0-.55.45-1 1-1z"/>'],
  ['LinkedIn', 'https://www.linkedin.com/company/144052802/', '<path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.06c.53-1 1.82-2.06 3.75-2.06 4 0 4.74 2.64 4.74 6.07V21h-4v-5.27c0-1.26-.02-2.88-1.75-2.88-1.76 0-2.03 1.37-2.03 2.79V21h-4z"/>'],
  ['YouTube', 'https://www.youtube.com/@DevLensBangladesh', '<path fill-rule="evenodd" d="M23 7.2a3 3 0 0 0-2.1-2.12C19.03 4.6 12 4.6 12 4.6s-7.03 0-8.9.48A3 3 0 0 0 1 7.2 31.4 31.4 0 0 0 .5 12a31.4 31.4 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.12c1.87.48 8.9.48 8.9.48s7.03 0 8.9-.48A3 3 0 0 0 23 16.8a31.4 31.4 0 0 0 .5-4.8 31.4 31.4 0 0 0-.5-4.8zM9.75 15.02V8.98L15.5 12z"/>'],
];
---
<div class={`social-links tone-${tone}`}>
  {label && <p class="social-label">{label}</p>}
  <div class="social-row">
    {links.map(([name, href, path]) => (
      <a href={href} target="_blank" rel="noopener" aria-label={`Devlens Bangladesh on ${name}`} title={name}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" set:html={path} />
      </a>
    ))}
    {email && (
      <a href="mailto:devlensbangladesh@gmail.com" class="social-mail" aria-label="Email Devlens Bangladesh" title="Email">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
        <span>devlensbangladesh@gmail.com</span>
      </a>
    )}
  </div>
</div>
